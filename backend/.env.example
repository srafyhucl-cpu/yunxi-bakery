# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 有赞云
YOUZAN_CLIENT_ID=your-client-id
YOUZAN_CLIENT_SECRET=your-client-secret
YOUZAN_KDT_ID=your-kdt-id

# 企业微信
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret
WECOM_TOKEN=your-wecom-token
WECOM_ENCODING_AES_KEY=your-aes-key
WECOM_KF_ID=your-kf-id
WECOM_STAFF_ID=your-staff-userid
WECOM_KF_SERVICER_USERID=your-kf-servicer-userid
WECOM_BOT_PLUGIN_API_KEY=your-wecom-intelligent-bot-plugin-key
WECOM_INTELLIGENT_BOT_TOKEN=your-wecom-intelligent-bot-callback-token
WECOM_INTELLIGENT_BOT_ENCODING_AES_KEY=your-wecom-intelligent-bot-callback-aes-key
WECOM_EMPLOYEE_AUTH_REQUIRED=true
WECOM_EMPLOYEE_ALLOWED_USERS=your-employee-userid
WECOM_EMPLOYEE_ALLOWED_CHATS=
WECOM_EMPLOYEE_CORP_ID=your-corp-id
WECOM_EMPLOYEE_OPS_USERS=your-ops-employee-userid
REMOTE_IMAGE_ALLOWED_HOSTS=img.yzcdn.cn

# 管理后台
ADMIN_API_TOKEN=your-admin-token

# 服务配置
SERVER_HOST=127.0.0.1
SERVER_PORT=7001
LOG_LEVEL=info
