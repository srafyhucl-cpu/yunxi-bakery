# ============================================================================
# 芸熙烘焙 · 本地开发环境变量示例（Local sample, NOT a production config）
#
# ⚠️ 这是「本地示例」，不是生产配置：
#    - 仓库内不写入任何真实密钥、真实 AppID、真实商户号、真实手机号；
#    - 本地试点默认走 Mock 打印 + Mock 支付，不接触真实打印机 / 真实支付 / 生产库；
#    - 生产上线必须另做真实凭据配置与对账，入口见
#      backend/docs/release/local-trial-runbook.md
#
# 用法（Windows PowerShell，仓库根目录执行）：
#     powershell -ExecutionPolicy Bypass -File scripts/setup.ps1
# 脚本会复制本文件为 backend/.env，并自动写入随机 ADMIN_API_TOKEN /
# ADMIN_SESSION_SECRET / STAFF_SESSION_SECRET / STOREFRONT_AUTH_SECRET。
#
# ⚠️ 直接把本文件改名成 .env 而不填密钥，后端会拒绝启动（安全检查）：
#    ADMIN_API_TOKEN 仍是保留默认值 / ADMIN_SESSION_SECRET 为空 → 启动即退出。
# ============================================================================

# ── 服务配置 ───────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=7001
LOG_LEVEL=info

# ── 数据库与检索（本地默认 SQLite + 关键词检索） ───────────────────────────
DB_PATH=data/bot.db
EMBEDDING_INDEX_DIR=data/embeddings
# 向量检索与混合检索本地默认关闭：本地不构建向量索引，走 BM25/SQL LIKE 关键词路径
ENABLE_VECTOR_RETRIEVAL=false
ENABLE_HYBRID_RETRIEVAL=false
RAG_RETRIEVAL_MODE=hybrid

# ── 小米 MiMo 大模型（主力 LLM；未配置时 AI 客服不可用，其余流程可用） ─────
# 只填你自己申请的 Key；不要把真实 Key 提交回仓库
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
MIMO_ASR_MODEL=mimo-v2.5-asr

# ── DeepSeek（已废弃，仅保留字段兼容；无需配置） ───────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 有赞云（本地固定 Mock 模式，不连真实有赞 API） ─────────────────────────
YOUZAN_CLIENT_ID=your-client-id
YOUZAN_CLIENT_SECRET=your-client-secret
YOUZAN_KDT_ID=your-kdt-id
# 本地试点必须保持 true：false 会真的去连有赞开放平台
YOUZAN_MOCK_MODE=true

# ── 企业微信（本地不启用；真实回调凭证上线前再填） ─────────────────────────
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret
WECOM_TOKEN=your-wecom-token
WECOM_ENCODING_AES_KEY=your-aes-key
WECOM_KF_ID=your-kf-id
WECOM_STAFF_ID=your-staff-userid
WECOM_KF_SERVICER_USERID=your-kf-servicer-userid
WECOM_BOT_PLUGIN_API_KEY=your-wecom-intelligent-bot-plugin-key
WECOM_INTELLIGENT_BOT_TOKEN=your-wecom-intelligent-bot-callback-token
WECOM_INTELLIGENT_BOT_ENCODING_AES_KEY=your-wecom-intelligent-bot-callback-aes-key
WECOM_EMPLOYEE_AUTH_REQUIRED=true
WECOM_EMPLOYEE_ALLOWED_USERS=your-employee-userid
WECOM_EMPLOYEE_ALLOWED_CHATS=
WECOM_EMPLOYEE_CORP_ID=your-corp-id
WECOM_EMPLOYEE_OPS_USERS=your-ops-employee-userid
REMOTE_IMAGE_ALLOWED_HOSTS=img.yzcdn.cn

# ── 微信小程序（本地试点默认不配置；不填则小程序登录会失败） ───────────────
# 真实 AppID / AppSecret 只在本地 .env 填，不要提交回仓库
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
# 前台会话签名密钥：setup.ps1 自动生成；为空时小程序登录态无法签发
STOREFRONT_AUTH_SECRET=
# 本地允许 Mock 支付（真实支付未接通）。生产必须置 false
ALLOW_MOCK_PAYMENT=true
# 本地不启用真实微信支付
WECHAT_PAY_ENABLED=false

# ── 管理后台（本地示例） ───────────────────────────────────────────────────
# ADMIN_API_TOKEN 不可用默认值：保留占位值时后端启动安全检查会直接退出。
# setup.ps1 会写入随机强口令；也可自行替换为随机字符串。
ADMIN_API_TOKEN=CHANGE_ME_IN_PRODUCTION_ENV
# 后台短会话签名密钥：setup.ps1 自动生成；为空时后端拒绝启动
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=1800
# 本地走 http://127.0.0.1:5173，Cookie 不加 Secure；生产必须置 true
ADMIN_COOKIE_SECURE=false

# ── 店员会话（与后台管理员会话完全隔离） ───────────────────────────────────
# setup.ps1 自动生成；为空时店员登录返回 503「店员会话密钥未配置」
STAFF_SESSION_SECRET=
# 店员班次会话时长（秒），默认 8 小时
STAFF_SESSION_TTL_SECONDS=28800

# ── 小票打印（本地固定 Mock 网关） ─────────────────────────────────────────
# mock 只把作业记为 MOCKED，绝不伪造 PRINTED（真实出纸只能人工确认）
PRINT_PROVIDER=mock
PRINT_MAX_ATTEMPTS=3
PRINT_TICKET_WIDTH=32
# 已支付订单 → 打印调度入队（持久游标 + 幂等入队）
PRINT_DISPATCH_ENABLED=true
PRINT_DISPATCH_INTERVAL_SECONDS=5
PRINT_DISPATCH_BATCH_SIZE=200
# 打印消费 worker：定时把 PENDING 作业交给网关
PRINT_WORKER_ENABLED=true
PRINT_WORKER_INTERVAL_SECONDS=2
PRINT_WORKER_BATCH_SIZE=20
# 飞鹅打印机凭证：只有真的要接实体打印机时才填（本地试点留空）
FEIEYUN_USER=
FEIEYUN_UKEY=
FEIEYUN_SN=
FEIEYUN_API_URL=https://api.feieyun.cn/Api/Open/
FEIEYUN_TIMEOUT_SECONDS=10

# ── API 文档与边缘防护 ─────────────────────────────────────────────────────
# 本地打开 Swagger：http://127.0.0.1:7001/docs（生产必须 false）
ENABLE_API_DOCS=true
# 本地单机模式：限流/登录计数落 SQLite；生产多机需切 redis
EDGE_PROTECTION_BACKEND=sqlite
EDGE_REQUIRE_SHARED=false
