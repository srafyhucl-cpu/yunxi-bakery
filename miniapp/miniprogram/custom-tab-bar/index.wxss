.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  padding: 0 22rpx calc(env(safe-area-inset-bottom) + 16rpx);
  pointer-events: none;
}

.tabbar-island {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 120rpx;
  padding: 10rpx 14rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 40rpx rgba(36, 58, 40, 0.08);
  pointer-events: auto;
}

.tabbar-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 98rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  color: #728073;
  border-radius: 999rpx;
  margin: 0 6rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-size: 26rpx 26rpx;
  background-repeat: no-repeat;
  background-position: center;
  transition: all 0.2s ease;
}

