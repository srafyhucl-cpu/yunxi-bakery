.tabbar-label {
  color: #828E86;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  transition: all 0.25s ease;
  white-space: nowrap;
}

/* 激活态：轻盈浮起，变色加粗，无粗暴绿色底块 */
.tabbar-item.is-active {
  background: var(--yunxi-brand-soft);
}

.tabbar-item.is-active .tabbar-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tabbar-item.is-active .tabbar-label {
  color: var(--yunxi-brand);
  font-weight: 800;
}
