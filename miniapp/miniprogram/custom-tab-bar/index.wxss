.tabbar-label {
  color: #728073;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.tabbar-item.is-active {
  background: linear-gradient(135deg, #3f7a42 0%, #315d35 100%);
  box-shadow: 0 8rpx 20rpx rgba(49, 93, 53, 0.25);
}

.tabbar-item.is-active .tabbar-icon {
  background-color: #ffffff;
}

.tabbar-item.is-active .tabbar-label {
  color: #ffffff;
  font-weight: 800;
}
