.tabbar-label {
  color: #8D968F;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 400;
  transition: color 0.15s ease;
  white-space: nowrap;
}

/* 激活态：只换色与字重，不做底块 */
.tabbar-item.is-active {
  background: transparent;
}

.tabbar-item.is-active .tabbar-icon {
  transform: translateY(-1rpx);
}

.tabbar-item.is-active .tabbar-label {
  color: var(--yunxi-brand);
  font-weight: 600;
}
