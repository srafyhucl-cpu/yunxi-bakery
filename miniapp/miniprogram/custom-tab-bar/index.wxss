/* ==========================================================================
   自定义底部导航栏 - 清晰的底部工具栏
   ========================================================================== */

.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  padding: 0 28rpx calc(env(safe-area-inset-bottom) + 14rpx);
  pointer-events: none;
}

.tabbar-island {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  height: 116rpx;
  padding: 8rpx 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  box-shadow: var(--yunxi-floating-shadow);
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  color: #828E86;
  border-radius: var(--yunxi-radius-sm);
  margin: 0 4rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.tabbar-item:active {
  transform: scale(0.92);
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

