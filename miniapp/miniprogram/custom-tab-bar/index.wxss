/* ==========================================================================
   自定义底部导航栏 —— 全宽平面工具栏
   仅换色与字重表达选中态，不做悬浮胶囊、不做底块。
   ========================================================================== */

.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--yunxi-surface);
  border-top: 1rpx solid var(--yunxi-border);
  box-shadow: 0 -2rpx 12rpx rgba(37, 48, 42, 0.04);
  pointer-events: none;
}

.tabbar-island {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  height: 112rpx;
  padding: 6rpx 8rpx;
  overflow: hidden;
  background: var(--yunxi-surface);
  border: 0;
  border-radius: 0;
  box-shadow: none;
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  color: #8D968F;
  border-radius: 0;
  margin: 0;
  transition: opacity 0.15s ease;
}

.tabbar-item:active {
  opacity: 0.6;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  transition: transform 0.15s ease;
}

