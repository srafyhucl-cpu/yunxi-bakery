/* ==========================================================================
   芸熙烘焙：温暖精品烘焙 + 现代极简电商
   ========================================================================== */

page {
  /* 基础间距与安全区尺寸 */
  --yunxi-page-gutter: 28rpx;
  --yunxi-custom-nav-space: calc(env(safe-area-inset-top) + 20rpx);
  --yunxi-page-bottom-space: calc(env(safe-area-inset-bottom) + 200rpx);
  --yunxi-tabbar-occupied-height: calc(env(safe-area-inset-bottom) + 128rpx);
  --yunxi-fixed-action-space: calc(env(safe-area-inset-bottom) + 276rpx);

  /* 背景与表面系统 (方案 B：晨曦暖灰白 + 纯白卡片) */
  --yunxi-page-bg: #F7F5F1;
  --yunxi-surface: #FFFFFF;
  --yunxi-surface-alt: #F1EEE8;

  /* 品牌色系统 (森林墨绿系) */
  --yunxi-brand: #3D332D;
  --yunxi-brand-light: #625248;
  --yunxi-brand-soft: rgba(61, 51, 45, 0.08);
  --yunxi-accent: #3D332D;
  --yunxi-accent-deep: #2B231F;
  --yunxi-accent-soft: rgba(61, 51, 45, 0.08);

  /* 点缀色 (焦糖烘烤金 + 法式烤栗红) */
  --yunxi-gold: #B68A53;
  --yunxi-gold-light: #D7B984;
  --yunxi-gold-soft: rgba(182, 138, 83, 0.12);
  --yunxi-price: #1C201D;
  --yunxi-deal: #BA4E3D;

  /* 文字排印阶梯 */
  --yunxi-text-primary: #2B2724;
  --yunxi-text-secondary: #665E58;
  --yunxi-text-muted: #8E8780;
  --yunxi-text-subtle: #B8B1A9;

  /* 边框与阴影体系 */
  --yunxi-border: rgba(61, 51, 45, 0.10);
  --yunxi-border-medium: rgba(61, 51, 45, 0.20);
  --yunxi-card-shadow: 0 4rpx 16rpx rgba(61, 51, 45, 0.04);
  --yunxi-floating-shadow: 0 10rpx 24rpx rgba(61, 51, 45, 0.08);
  --yunxi-shadow: 0 8rpx 24rpx rgba(61, 51, 45, 0.06);

  /* 圆角规范 */
  --yunxi-radius-sm: 8rpx;
  --yunxi-radius-md: 10rpx;
  --yunxi-radius-lg: 12rpx;
  --yunxi-radius-full: 999rpx;

  height: 100vh;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  background: var(--yunxi-page-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button,
button:not([size="mini"]) {
  margin: 0;
  padding: 0;
  width: auto;
  min-height: 0;
  border-radius: 0;
  font: inherit;
  line-height: normal;
  background-color: transparent;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

/* ==========================================================================
   页面外壳与导航框架
   ========================================================================== */

.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--yunxi-page-bg);
}

.page-fixed-safe {
  position: relative;
  flex: 0 0 var(--yunxi-custom-nav-space);
  min-height: var(--yunxi-custom-nav-space);
  background: #ffffff;
  border-bottom: 1rpx solid rgba(61, 51, 45, 0.05);
  z-index: 100;
}

.page-fixed-safe::after {
  content: "芸熙烘焙";
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  transform: translateX(-50%);
  max-width: 360rpx;
  color: var(--yunxi-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.page-fixed-safe__home {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 8rpx;
  display: none;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  color: var(--yunxi-brand);
  font-size: 34rpx;
  font-weight: 800;
}

.page-fixed-safe__home:active {
  opacity: 0.72;
}

.page-fixed-safe__title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  bottom: 20rpx;
  display: none;
  align-items: center;
  justify-content: center;
  color: var(--yunxi-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  pointer-events: none;
}

.page-fixed-safe.has-custom-title::after {
  display: none;
}

.page-fixed-safe.has-custom-title .page-fixed-safe__home,
.page-fixed-safe.has-custom-title .page-fixed-safe__title {
  display: flex;
}

button.page-nav-back,
.page-nav-back {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  height: 88rpx !important;
  min-height: 88rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box;
  color: var(--yunxi-text-primary);
  background: #ffffff;
  border: 1rpx solid var(--yunxi-border);
  border-radius: 50% !important;
  box-shadow: 0 4rpx 14rpx rgba(61, 51, 45, 0.08);
}

.page-nav-back:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.page-nav-back[disabled] {
  color: var(--yunxi-text-muted);
  background: var(--yunxi-surface-alt);
  border-color: var(--yunxi-border);
  box-shadow: none;
  opacity: 0.72;
}

.page-nav-back__icon {
  display: block;
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  border: solid currentColor;
  border-width: 0 4rpx 4rpx 0;
  border-radius: 2rpx;
  transform: rotate(135deg);
}

.page-pinned {
  flex: 0 0 auto;
  padding: 0 var(--yunxi-page-gutter) 18rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--yunxi-border);
  box-shadow: 0 8rpx 20rpx rgba(61, 51, 45, 0.03);
}

.page-pinned--empty {
  min-height: 0;
  padding: 0;
  border-bottom: 0;
  box-shadow: none;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  background: var(--yunxi-page-bg);
}

.page-top-spacer {
  display: none;
  height: 0;
}

.page {
  min-height: 100%;
  padding: 24rpx var(--yunxi-page-gutter) var(--yunxi-page-bottom-space);
}

/* ==========================================================================
   全局玻璃拟态与动效
   ========================================================================== */

.glass-panel {
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.hover-scale {
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.2s ease;
}

.hover-scale:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.fade-in {
  animation: fadeIn 0.35s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==========================================================================
   通用排版与按钮
   ========================================================================== */

.section-title {
  margin: 28rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
  letter-spacing: 0.02em;
}

.muted {
  color: var(--yunxi-text-muted);
  font-size: 26rpx;
}

button.primary-button,
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 32rpx;
  color: #ffffff;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 6rpx 14rpx rgba(61, 51, 45, 0.16);
  transition: all 0.2s ease;
}

.primary-button:active {
  transform: scale(0.97);
  opacity: 0.94;
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #A3B5AC;
  box-shadow: none;
}

button.ghost-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 28rpx;
  color: var(--yunxi-brand);
  background: #ffffff;
  border: 2rpx solid var(--yunxi-border-medium);
  border-radius: var(--yunxi-radius-sm);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.ghost-button:active {
  background: var(--yunxi-surface-alt);
  transform: scale(0.97);
}

.ghost-button[disabled] {
  color: var(--yunxi-text-muted);
  background: var(--yunxi-surface-alt);
  border-color: var(--yunxi-border);
}

.bakery-panel {
  background: #ffffff;
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  box-shadow: var(--yunxi-card-shadow);
}

.bakery-section-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 32rpx 0 20rpx;
  color: var(--yunxi-brand);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.bakery-section-heading::before,
.bakery-section-heading::after {
  content: "";
  width: 32rpx;
  height: 2rpx;
  background: var(--yunxi-gold);
  opacity: 0.7;
}

.bakery-feature-icon,
.bakery-action-icon,
.bakery-status-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 800;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-md);
  box-shadow: 0 8rpx 20rpx rgba(61, 51, 45, 0.18);
}

.bakery-feature-icon::after,
.bakery-action-icon::after,
.bakery-status-icon::after {
  content: "";
  position: absolute;
  inset: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: calc(var(--yunxi-radius-md) - 6rpx);
}

/* ==========================================================================
   通用卡片、步进器、徽标、价格、骨架屏
   ========================================================================== */

.yunxi-card {
  background: #ffffff;
  border-radius: var(--yunxi-radius-md);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

/* 统一步进器 */
.yunxi-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.yunxi-stepper__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 50%;
  transition: all 0.15s ease;
}

.yunxi-stepper__btn--minus {
  color: var(--yunxi-brand);
  background: #ffffff;
  border: 2rpx solid var(--yunxi-border-medium);
}

.yunxi-stepper__btn--plus {
  color: #ffffff;
  background: var(--yunxi-brand);
  border: 2rpx solid var(--yunxi-brand);
}

.yunxi-stepper__btn:active {
  transform: scale(0.9);
  opacity: 0.88;
}

.yunxi-stepper__val {
  min-width: 48rpx;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

/* 徽标体系 */
.yunxi-badge {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--yunxi-radius-full);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  white-space: nowrap;
}

.yunxi-badge.is-flagship {
  color: #ffffff;
  background: var(--yunxi-text-primary);
}

.yunxi-badge.is-new {
  color: #ffffff;
  background: var(--yunxi-gold);
}

.yunxi-badge.is-hot {
  color: #ffffff;
  background: var(--yunxi-brand);
}

.yunxi-badge.is-limited {
  color: #BA4E3D;
  background: #FDF1EE;
  border: 1rpx solid rgba(186, 78, 61, 0.2);
}

/* 价格展示 */
.yunxi-price {
  color: var(--yunxi-price);
  font-weight: 900;
  letter-spacing: 0;
}

.yunxi-price__unit {
  margin-left: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 500;
}

/* 芯片标签 */
.yunxi-chip {
  padding: 8rpx 20rpx;
  color: var(--yunxi-text-secondary);
  background: var(--yunxi-surface-alt);
  border-radius: var(--yunxi-radius-full);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}

/* 优雅通透的占位图 */
.yunxi-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: var(--yunxi-surface-alt);
}

.yunxi-image-fallback__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: var(--yunxi-brand);
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid var(--yunxi-border-medium);
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 16rpx rgba(61, 51, 45, 0.08);
}

/* 骨架屏 */
.yunxi-skeleton {
  background: #E8E2DA;
}


/* 统一状态占位区 (空态/报错) */
.yunxi-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.yunxi-state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border: 1rpx solid var(--yunxi-border);
  border-radius: 40rpx;
  box-shadow: var(--yunxi-card-shadow);
  font-size: 64rpx;
}

.yunxi-state__title {
  color: var(--yunxi-text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.yunxi-state__hint {
  color: var(--yunxi-text-muted);
  font-size: 26rpx;
  line-height: 1.5;
  max-width: 480rpx;
}

.yunxi-state__action {
  min-width: 240rpx;
  margin-top: 24rpx;
}
