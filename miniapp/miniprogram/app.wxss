page {
  --yunxi-page-gutter: 28rpx;
  --yunxi-custom-nav-space: calc(env(safe-area-inset-top) + 18rpx);
  --yunxi-page-bottom-space: calc(env(safe-area-inset-bottom) + 200rpx);
  --yunxi-tabbar-occupied-height: calc(env(safe-area-inset-bottom) + 128rpx);
  --yunxi-fixed-action-space: calc(env(safe-area-inset-bottom) + 276rpx);
  --yunxi-page-bg: #FAF8F5;
  --yunxi-surface: #ffffff;
  --yunxi-surface-alt: #F4F1EB;
  --yunxi-text-primary: #2C2520;
  --yunxi-text-secondary: #756D66;
  --yunxi-text-muted: #A39B93;
  --yunxi-accent: #6C9A63;
  --yunxi-accent-deep: #4A7A41;
  --yunxi-accent-soft: rgba(108, 154, 99, 0.12);
  --yunxi-border: rgba(44, 37, 32, 0.08);
  --yunxi-shadow: 0 16rpx 40rpx rgba(108, 154, 99, 0.15);
  --yunxi-radius-lg: 32rpx;
  --yunxi-radius-md: 24rpx;
  --yunxi-radius-sm: 16rpx;

  height: 100vh;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  background: var(--yunxi-page-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--yunxi-page-bg);
}

.page-fixed-safe {
  position: relative;
  flex: 0 0 var(--yunxi-custom-nav-space);
  min-height: var(--yunxi-custom-nav-space);
  background: #ffffff;
}

.page-fixed-safe::after {
  content: "芸熙烘焙";
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  transform: translateX(-50%);
  max-width: 360rpx;
  color: #243a28;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.page-fixed-safe__home {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 0;
  display: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: var(--yunxi-accent-deep);
  font-size: 34rpx;
  font-weight: 900;
}

.page-fixed-safe__title {
  position: absolute;
  left: 116rpx;
  right: 116rpx;
  bottom: 18rpx;
  display: none;
  color: #17223a;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.page-fixed-safe.has-custom-title::after {
  display: none;
}

.page-fixed-safe.has-custom-title .page-fixed-safe__home,
.page-fixed-safe.has-custom-title .page-fixed-safe__title {
  display: flex;
}

.page-nav-back {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: var(--yunxi-text-primary);
  background: rgba(237, 247, 232, 0.9);
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 50%;
}

.page-nav-back[disabled] {
  color: var(--yunxi-text-muted);
  background: rgba(245, 248, 243, 0.86);
  border-color: rgba(75, 129, 72, 0.08);
  opacity: 0.72;
}

.page-nav-back__icon {
  margin-top: -4rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 700;
}

.page-pinned {
  flex: 0 0 auto;
  padding: 0 var(--yunxi-page-gutter) 18rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(75, 129, 72, 0.08);
  box-shadow: 0 10rpx 24rpx rgba(54, 103, 56, 0.045);
}

.product-art.cake-yellow .product-art-base {
  background: #edf7e8;
  border-bottom-color: #8bbf74;
}

/* 玻璃拟态与动画 */
.glass-panel {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.04);
}

.hover-scale {
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.2s ease;
}

.hover-scale:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.fade-in {
  animation: fadeIn 0.4s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-pinned--empty {
  min-height: 0;
  padding: 0;
  border-bottom: 0;
  box-shadow: none;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  background:
    radial-gradient(circle at 10% 5%, rgba(108, 154, 99, 0.45), transparent 45%),
    radial-gradient(circle at 90% 25%, rgba(229, 175, 110, 0.35), transparent 50%),
    radial-gradient(circle at 30% 75%, rgba(108, 154, 99, 0.25), transparent 60%),
    var(--yunxi-page-bg);
}

.page-top-spacer {
  display: none;
  height: 0;
}

.page {
  min-height: 100%;
  padding: 24rpx var(--yunxi-page-gutter) var(--yunxi-page-bottom-space);
}

.section-title {
  margin: 24rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #7BBA6E 0%, #428036 100%);
  border-radius: 999rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 32rpx rgba(66, 128, 54, 0.3);
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.86);
  background: linear-gradient(180deg, #b8c7b0 0%, #8fa08b 100%);
  box-shadow: none;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: var(--yunxi-accent-deep);
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--yunxi-border);
  border-radius: 999rpx;
  font-weight: 700;
}

.ghost-button[disabled] {
  color: var(--yunxi-text-muted);
  background: rgba(245, 248, 243, 0.86);
  border-color: rgba(75, 129, 72, 0.08);
}

.bakery-panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-lg);
  box-shadow: var(--yunxi-shadow);
}

.bakery-section-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 0 20rpx;
  color: var(--yunxi-accent-deep);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.bakery-section-heading::before,
.bakery-section-heading::after {
  content: "";
  width: 28rpx;
  height: 2rpx;
  background: rgba(139, 191, 116, 0.65);
}

.bakery-feature-icon,
.bakery-action-icon,
.bakery-status-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #274D29;
  font-weight: 700;
  background: radial-gradient(circle at 30% 24%, #F2F8EE, #7BBA6E 74%);
  box-shadow: 0 8rpx 16rpx rgba(108, 154, 99, 0.2);
}

.bakery-feature-icon::after,
.bakery-action-icon::after,
.bakery-status-icon::after {
  content: "";
  position: absolute;
  inset: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 14rpx;
}

.bakery-photo {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0) 28%),
    linear-gradient(135deg, #eaf7e3 0%, #ffffff 58%, #cce8bf 100%);
}

.bakery-photo::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  width: 74%;
  height: 18rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(154, 116, 76, 0.24), transparent 70%);
}

.bakery-photo.cake-pink::after,
.bakery-photo.cake-cream::after,
.bakery-photo.cake-choco::after,
.bakery-photo.cake-yellow::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 26rpx;
  width: 128rpx;
  height: 128rpx;
  transform: translateX(-50%);
  border-radius: 50%;
}

.bakery-photo.cake-pink::after {
  background:
    radial-gradient(circle at 48% 18%, #fff1ef 0 14%, transparent 15%),
    radial-gradient(circle at 38% 26%, #efb7a5 0 10%, transparent 11%),
    radial-gradient(circle at 62% 25%, #e4a296 0 10%, transparent 11%),
    radial-gradient(circle at 50% 62%, #d07a65 0 52%, #9b5e3e 53% 61%, transparent 62%);
}

.bakery-photo.cake-cream::after {
  background:
    radial-gradient(circle at 38% 26%, #fff8eb 0 12%, transparent 13%),
    radial-gradient(circle at 60% 24%, #f1dcc0 0 11%, transparent 12%),
    radial-gradient(circle at 50% 62%, #fff5e4 0 52%, #ecdabc 53% 61%, transparent 62%);
}

.bakery-photo.cake-choco::after {
  background:
    radial-gradient(circle at 40% 24%, #f5d6c1 0 9%, transparent 10%),
    radial-gradient(circle at 58% 22%, #d4a382 0 10%, transparent 11%),
    radial-gradient(circle at 50% 62%, #6e402e 0 52%, #573222 53% 61%, transparent 62%);
}

.bakery-photo.cake-yellow::after {
  background:
    radial-gradient(circle at 50% 16%, #fffdf5 0 12%, transparent 13%),
    radial-gradient(circle at 50% 62%, #f1ce76 0 52%, #deb555 53% 61%, transparent 62%);
}
