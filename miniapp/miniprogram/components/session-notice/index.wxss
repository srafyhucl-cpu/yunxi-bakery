/* ==========================================================================
   会话状态通知组件 (Session Notice Component) - 现代自然轻食风格重塑
   ========================================================================== */

.session-notice {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  box-shadow: var(--yunxi-card-shadow);
  margin-bottom: 16rpx;
}

.session-notice__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 auto;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(61, 51, 45, 0.16);
}

.session-notice__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.session-notice__title {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.session-notice__desc {
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.session-notice__button,
button.session-notice__button {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 120rpx !important;
  height: 88rpx !important;
  min-height: 88rpx !important;
  padding: 0 28rpx !important;
  margin: 0 !important;
  border-radius: var(--yunxi-radius-sm);
  color: #FFFFFF;
  background: var(--yunxi-brand);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2 !important;
  white-space: nowrap;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(61, 51, 45, 0.16);
  transition: all 0.2s ease;
}

.session-notice__button:active {
  transform: scale(0.96);
  opacity: 0.92;
}
