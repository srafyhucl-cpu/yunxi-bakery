.session-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(75, 129, 72, 0.1);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(54, 103, 56, 0.045);
}

.session-notice__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  color: #ffffff;
  background: linear-gradient(180deg, #8bbf74 0%, #3f7a42 100%);
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.session-notice__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.session-notice__title {
  color: #243a28;
  font-size: 26rpx;
  font-weight: 700;
}

.session-notice__desc {
  color: #6e806f;
  font-size: 22rpx;
  line-height: 1.45;
}

.session-notice__button {
  min-width: 128rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #8bbf74 0%, #3f7a42 100%);
  font-size: 24rpx;
  font-weight: 700;
}
