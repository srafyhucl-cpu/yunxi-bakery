<view class="session-notice">
  <view class="session-notice__icon">{{iconText}}</view>
  <view class="session-notice__copy">
    <text class="session-notice__title">{{statusText}} · {{badgeText}}</text>
    <text class="session-notice__desc">{{description}}</text>
  </view>
  <view
    wx:if="{{actionText}}"
    class="session-notice__button"
    role="button"
    aria-label="{{actionText}}"
    bindtap="handleAction"
  >{{actionText}}</view>
</view>
