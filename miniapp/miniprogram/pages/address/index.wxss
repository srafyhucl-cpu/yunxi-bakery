/* ==========================================================================
   收货地址管理页 (Address Management Page) - 现代自然轻食风格重塑
   ========================================================================== */

.address-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 28rpx 80rpx;
}

.address-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.address-header__info {
  flex: 1;
  min-width: 0;
}

.address-subtitle {
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
}

button.address-add,
.address-add {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 144rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 28rpx !important;
  margin: 0 !important;
  border-radius: var(--yunxi-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.address-error {
  padding: 18rpx 24rpx;
  color: var(--yunxi-deal);
  background: #FDF1EE;
  border: 1rpx solid rgba(186, 78, 61, 0.2);
  border-radius: var(--yunxi-radius-md);
  font-size: 24rpx;
  line-height: 1.45;
}

.address-form,
.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.address-form {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-md);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

input,
textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  font-size: 28rpx;
  color: var(--yunxi-text-primary);
}

textarea {
  height: 180rpx;
  min-height: 180rpx;
  padding-top: 24rpx;
}

.address-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.address-actions,
.address-card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-actions button {
  flex: 1;
}

.address-empty {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-md);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.address-empty-title {
  color: var(--yunxi-text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.address-empty-text {
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.address-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  overflow: hidden;
  transition: background 0.2s ease;
}

.address-card:active {
  background: var(--yunxi-surface-alt);
}

.address-card-title {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.address-badge {
  padding: 4rpx 14rpx;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 20rpx;
  font-weight: 700;
}

.address-card-detail {
  display: block;
  margin: 14rpx 0 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

button.text-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx !important;
  height: 88rpx !important;
  padding: 0 24rpx;
  color: var(--yunxi-brand);
  background: var(--yunxi-surface-alt);
  border-radius: var(--yunxi-radius-full);
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.text-button:active {
  transform: scale(0.96);
}

.text-button.danger {
  color: var(--yunxi-deal);
  background: #FDF1EE;
}

.text-button[disabled] {
  color: var(--yunxi-text-subtle);
  background: var(--yunxi-surface-alt);
}

.text-button.danger[disabled] {
  color: var(--yunxi-text-subtle);
  background: var(--yunxi-surface-alt);
}
