.address-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.address-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.address-header .section-title {
  display: block;
  margin: 0 0 10rpx;
}

.address-subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
}

.address-add {
  flex: 0 0 auto;
  min-width: 144rpx;
}

.address-error {
  padding: 18rpx 22rpx;
  color: #c0342b;
  background: #fff4f0;
  border: 1rpx solid #f0c1b6;
  border-radius: 18rpx;
  font-size: 24rpx;
}


.address-form,
.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.address-form {
  padding: 22rpx;
}

input,
textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fbf6;
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 18rpx;
  font-size: 28rpx;
}

textarea {
  min-height: 180rpx;
  padding-top: 24rpx;
}

.address-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fbf6;
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 18rpx;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
}

.address-actions,
.address-card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-actions button {
  flex: 1;
}

.address-empty {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 72rpx 40rpx;
  text-align: center;
}

.address-empty-title {
  color: var(--yunxi-text-primary);
  font-size: 34rpx;
  font-weight: 800;
}

.address-empty-text {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.address-card {
  padding: 28rpx;
}

.address-card-title {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.address-badge {
  padding: 4rpx 12rpx;
  color: var(--yunxi-accent-deep);
  background: rgba(139, 191, 116, 0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.address-card-detail {
  display: block;
  margin: 14rpx 0 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 18rpx;
  color: var(--yunxi-text-secondary);
  background: #f8fbf6;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.text-button.danger {
  color: #c0342b;
  background: #fff4f0;
}

.text-button[disabled] {
  color: var(--yunxi-text-muted);
  background: #eef4eb;
}

.text-button.danger[disabled] {
  color: #d7a19a;
  background: #fff7f4;
}
