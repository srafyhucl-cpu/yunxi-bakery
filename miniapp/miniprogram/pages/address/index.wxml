<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <button
      class="page-nav-back"
      bindtap="goBack"
      disabled="{{savingAddress || defaultingAddressId || deletingAddressId}}"
      aria-label="返回"
    >
      <text class="page-nav-back__icon">‹</text>
    </button>
    <view class="page-fixed-safe__title">{{mode === 'select' ? '选择地址' : '收货地址'}}</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page address-page">
      <session-notice
        wx:if="{{loginStateText}}"
        status-text="{{sessionView.statusText}}"
        badge-text="{{sessionView.badgeText}}"
        description="{{loginStateText}}"
        action-text="返回"
        icon-text="址"
        bind:action="goBack"
      ></session-notice>
      <view class="address-header">
        <view>
          <text class="section-title">收货地址</text>
          <text class="address-subtitle">{{mode === 'select' ? '选择后将自动回填结算信息' : '管理常用联系人和配送地址'}}</text>
        </view>
        <button class="ghost-button address-add" bindtap="startCreate" disabled="{{savingAddress}}">新增</button>
      </view>

      <view wx:if="{{errorMessage}}" class="address-error">{{errorMessage}}</view>

      <view wx:if="{{editing}}" class="address-form bakery-panel">
        <input placeholder="联系人" value="{{draft.receiverName}}" data-field="receiverName" bindinput="updateDraftField" />
        <input placeholder="手机号，例：18800000000" type="number" maxlength="11" value="{{draft.receiverPhone}}" data-field="receiverPhone" bindinput="updateDraftField" />
        <textarea placeholder="收货地址，如小区、楼栋、门牌号" value="{{draft.address}}" data-field="address" bindinput="updateDraftField" />
        <view class="address-switch">
          <text>设为默认地址</text>
          <switch checked="{{draft.isDefault}}" bindchange="toggleDraftDefault" color="#3f7a42" />
        </view>
        <view class="address-actions">
          <button class="ghost-button" bindtap="cancelEdit" disabled="{{savingAddress}}">取消</button>
          <button
            class="primary-button"
            bindtap="saveDraft"
            loading="{{savingAddress}}"
            disabled="{{savingAddress}}"
          >保存地址</button>
        </view>
      </view>

      <view wx:elif="{{addresses.length === 0}}" class="address-empty bakery-panel">
        <text class="address-empty-title">还没有收货地址</text>
        <text class="address-empty-text">先新增一个常用地址，结算时会自动带出联系人和电话。</text>
      </view>

      <view wx:else class="address-list">
        <view wx:for="{{addresses}}" wx:key="id" class="address-card bakery-panel" data-id="{{item.id}}" bindtap="chooseAddress">
          <view class="address-card-main">
            <view class="address-card-title">
              <text>{{item.receiverName}}</text>
              <text>{{item.receiverPhone}}</text>
              <text wx:if="{{item.isDefault}}" class="address-badge">默认</text>
            </view>
            <text class="address-card-detail">{{item.address}}</text>
          </view>
          <view class="address-card-actions">
            <button
              wx:if="{{!item.isDefault}}"
              class="text-button"
              data-id="{{item.id}}"
              catchtap="markDefault"
              loading="{{defaultingAddressId === item.id}}"
              disabled="{{defaultingAddressId || deletingAddressId || savingAddress}}"
            >设默认</button>
            <button
              class="text-button"
              data-id="{{item.id}}"
              catchtap="startEdit"
              disabled="{{defaultingAddressId || deletingAddressId || savingAddress}}"
            >编辑</button>
            <button
              class="text-button danger"
              data-id="{{item.id}}"
              catchtap="removeAddress"
              loading="{{deletingAddressId === item.id}}"
              disabled="{{defaultingAddressId || deletingAddressId || savingAddress}}"
            >删除</button>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
