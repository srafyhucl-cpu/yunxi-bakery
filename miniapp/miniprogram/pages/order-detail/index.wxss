/* ==========================================================================
   订单详情 —— 画册式版面（品牌色带 + 细线时间线 + 纸色操作区）
   1. 顶部状态是整块深林绿品牌色带，奶油色文字；刷新按钮改为反白细线小按钮。
   2. 进度时间线用 1rpx 细线 + 32rpx 小圆点，不做节点卡片。
   3. 信息 / 金额 / 履约都是细线行：label 22rpx muted，value 26rpx。
   4. 操作区随内容流，纸色底 + 深林绿主按钮 + 细线次按钮。
   ========================================================================== */

.order-detail-page {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 64rpx);
  background: var(--yunxi-page-bg);
}

/* 内容单元：无描边、无阴影的柔白平面 */
.order-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 32rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface);
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.order-card--progress,
.order-card--meta,
.order-card--items,
.order-card--fulfillment {
  margin-top: 24rpx;
}

/* 订单状态：整块深林绿品牌色带 */
.order-card--status {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx var(--yunxi-page-gutter);
  background: var(--yunxi-brand);
  border-bottom: 0;
}

.order-card--status > view {
  flex: 1;
  min-width: 0;
}

/* 色带里的字段名：奶油色 overline */
.order-card--status .order-label {
  display: block;
  color: rgba(247, 244, 236, 0.62);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.16em;
}

/* 状态文字：42rpx / 400，靠留白而不是加粗撑场 */
.order-status {
  display: block;
  margin-top: 12rpx;
  color: #F7F4EC;
  font-size: 42rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  line-height: 1.25;
}

.payment-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: rgba(247, 244, 236, 0.66);
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 0.16em;
}

.payment-status::before {
  content: "";
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--yunxi-gold-light);
}

/* 刷新按钮：色带上的反白细线小按钮 */
.order-card--status button.compact-button,
.order-card--status .compact-button {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 132rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: var(--yunxi-radius-sm);
  color: #F7F4EC;
  background: transparent;
  border: 1rpx solid rgba(247, 244, 236, 0.5);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}

.order-card--status button.compact-button[disabled],
.order-card--status .compact-button[disabled] {
  color: rgba(247, 244, 236, 0.5);
  background: transparent;
  border-color: rgba(247, 244, 236, 0.26);
}

/* 分区标题：28rpx / 500，不再用粗黑大标题 */
.section-title {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.1em;
  margin: 0;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 16rpx;
  height: 2rpx;
  margin-right: 10rpx;
  vertical-align: middle;
  background: var(--yunxi-gold);
}

.section-title--divider {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--yunxi-border);
}

.progress-hint {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-list {
  display: flex;
  flex-direction: column;
  margin-top: 4rpx;
}

/* 时间线：1rpx 细线 + 32rpx 小圆点 */
.progress-step {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.progress-step::after {
  position: absolute;
  top: 34rpx;
  bottom: 0;
  left: 15rpx;
  width: 1rpx;
  background: var(--yunxi-border-medium);
  content: "";
}

.progress-step:last-child {
  padding-bottom: 0;
}

.progress-step:last-child::after {
  display: none;
}

.progress-marker {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  color: #F7F4EC;
  background: var(--yunxi-text-subtle);
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1;
}

.progress-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 2rpx;
}

.progress-title {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.progress-desc {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-time,
.progress-note {
  display: block;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.progress-step--done .progress-marker,
.progress-step--current .progress-marker {
  background: var(--yunxi-brand);
}

.progress-step--current .progress-title {
  color: var(--yunxi-text-primary);
  font-weight: 500;
}

.progress-step--todo .progress-marker {
  background: var(--yunxi-surface);
  border: 1rpx solid var(--yunxi-border-medium);
  color: var(--yunxi-text-subtle);
}

.progress-step--cancelled .progress-marker {
  background: var(--yunxi-text-subtle);
}

.progress-step--cancelled .progress-title,
.progress-step--cancelled .progress-desc {
  color: var(--yunxi-text-muted);
}

/* 信息行：label 弱、value 强 */
.order-row,
.product-row,
.order-total-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.order-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  font-size: 26rpx;
  color: var(--yunxi-text-primary);
  line-height: 1.55;
}

.order-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.order-row > text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-word;
  font-size: 26rpx;
  color: var(--yunxi-text-primary);
}

.order-label {
  flex: 0 0 auto;
  max-width: 240rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.55;
}

/* 商品明细：无卡片，细线行 */
.product-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.product-row > view {
  flex: 1;
  min-width: 0;
}

.product-title,
.product-meta {
  display: block;
}

.product-title {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
}

.product-meta {
  margin-top: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.product-subtotal {
  flex: 0 0 auto;
  color: var(--yunxi-price);
  font-size: 28rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* 金额明细 */
.order-total-row {
  align-items: baseline;
  padding-top: 14rpx;
  font-size: 24rpx;
  color: var(--yunxi-text-secondary);
}

.order-total-row > text:last-child {
  flex: 0 0 auto;
  text-align: right;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.order-total-row:last-child {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--yunxi-border);
  font-size: 28rpx;
  color: var(--yunxi-text-primary);
}

.order-total-row:last-child > text:last-child {
  color: var(--yunxi-price);
  font-size: 30rpx;
  font-weight: 500;
}

/* 操作区：随内容流的纸色带 */
.order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 28rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface-cream);
  border-top: 0;
}

.order-actions button {
  flex: 1 1 calc(50% - 8rpx);
  width: auto !important;
  min-width: 180rpx;
  min-height: 96rpx !important;
  height: 96rpx !important;
  border-radius: var(--yunxi-radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}

/* 取消订单：细线描边，不与主按钮抢层级 */
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 24rpx;
  color: var(--yunxi-deal);
  background: transparent;
  border: 1rpx solid rgba(180, 84, 63, 0.4);
  border-radius: var(--yunxi-radius-sm);
  font-size: 26rpx;
}

.danger-button:active {
  opacity: 0.7;
}

.danger-button[disabled] {
  color: var(--yunxi-text-subtle);
  background: transparent;
  border-color: var(--yunxi-border);
}

/* 加载态：极简转圈 + 说明，避免交易页出现裸文字 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 58vh;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  color: var(--yunxi-text-muted);
  font-size: 26rpx;
}

.empty::before {
  content: "";
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--yunxi-border);
  border-top-color: var(--yunxi-brand);
  border-radius: 50%;
  animation: order-detail-spin 0.9s linear infinite;
}

@keyframes order-detail-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
