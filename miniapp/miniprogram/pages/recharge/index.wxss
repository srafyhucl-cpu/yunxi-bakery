/* ==========================================================================
   储值充值页 (Recharge Page) - 现代自然轻食风格重塑
   ========================================================================== */

.recharge-page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recharge-page .empty-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  border-radius: var(--yunxi-radius-md);
  text-align: center;
}

.recharge-page .empty-title {
  color: var(--yunxi-text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.recharge-page .empty-subtitle {
  margin-top: 12rpx;
  color: var(--yunxi-text-muted);
  font-size: 25rpx;
}

.balance-panel {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.balance-label {
  font-size: 26rpx;
  color: var(--yunxi-text-muted);
}

.balance-value {
  margin-top: 12rpx;
  font-size: 68rpx;
  font-weight: 900;
  color: var(--yunxi-text-primary);
  letter-spacing: 0;
}

.tier-panel,
.records-panel {
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
  margin-bottom: 24rpx;
}

.tier-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.tier-cell {
  padding: 28rpx 0;
  text-align: center;
  border-radius: var(--yunxi-radius-md);
  border: 2rpx solid var(--yunxi-border);
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  line-height: 1.25;
  overflow: hidden;
  transition: all 0.2s ease;
}

.tier-cell:active {
  opacity: 0.78;
}

.tier-cell.active {
  border-color: var(--yunxi-brand);
  background: var(--yunxi-brand-soft);
}

.tier-amount {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--yunxi-text-primary);
}

.tier-bonus {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--yunxi-deal);
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.custom-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--yunxi-text-primary);
}

.custom-input-wrap {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--yunxi-border-medium);
  border-radius: var(--yunxi-radius-sm);
  background: var(--yunxi-surface-alt);
}

.custom-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0;
  font-size: 32rpx;
  line-height: 88rpx;
  color: var(--yunxi-text-primary);
}

.custom-input-placeholder {
  color: var(--yunxi-text-muted);
}

.custom-unit {
  font-size: 26rpx;
  color: var(--yunxi-text-muted);
}

.bonus-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.records-empty {
  align-items: flex-start;
  text-align: left;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.record-row:last-child {
  border-bottom: none;
}

.record-main {
  flex: 1;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--yunxi-text-primary);
}

.recharge-page button.primary-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(61, 51, 45, 0.16);
}

.recharge-page button.primary-btn[disabled] {
  color: var(--yunxi-text-secondary) !important;
  background: var(--yunxi-surface-alt) !important;
  border: 1rpx solid var(--yunxi-border-medium) !important;
  box-shadow: none;
}

.recharge-page button.primary-btn:active {
  transform: scale(0.97);
  opacity: 0.94;
}

.record-cancel {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  min-height: 48rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--yunxi-deal);
}

.record-cancel:active {
  opacity: 0.65;
}
