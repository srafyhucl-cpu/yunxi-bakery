<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <button class="page-nav-back" bindtap="goBack" disabled="{{submitting}}" aria-label="返回">
      <text class="page-nav-back__icon"></text>
    </button>
    <view class="page-fixed-safe__title">确认订单</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page checkout-page">
      <session-notice
        wx:if="{{loginStateText}}"
        status-text="{{sessionView.statusText}}"
        badge-text="{{sessionView.badgeText}}"
        description="{{loginStateText}}"
        action-text="{{isLoggedIn ? '返回' : '去登录'}}"
        icon-text="结"
        bind:action="handleSessionAction"
      ></session-notice>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="checkout-summary yunxi-card hover-scale fade-in">
        <view>
          <text class="checkout-summary__eyebrow">本次购买</text>
          <text class="checkout-summary__hint">{{checkoutItems.length}} 件商品 · 自提价</text>
        </view>
        <text class="checkout-total">{{totalText}}</text>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="checkout-items">
        <view wx:for="{{checkoutItems}}" wx:key="productId" class="checkout-item">
          <view class="checkout-item__copy">
            <text class="checkout-item__title">{{item.title}}</text>
            <text class="checkout-item__meta">数量 × {{item.quantity}}</text>
          </view>
          <text class="checkout-item__price">{{item.priceText}}</text>
        </view>
      </view>
      <view wx:if="{{isLoggedIn && !checkoutItems.length}}" class="yunxi-state checkout-empty-state">
        <view class="yunxi-state__icon">购</view>
        <text class="yunxi-state__title">还没有选择商品</text>
        <text class="yunxi-state__hint">先从商品列表选择蛋糕或点心，再确认自提或北京闪送</text>
        <button class="primary-button yunxi-state__action" bindtap="goShopping">去选购</button>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="delivery-tabs">
        <button
          class="delivery-tab {{deliveryType === 'pickup' ? 'is-active' : ''}}"
          data-type="pickup"
          bindtap="selectDeliveryType"
        >
          到店自提｜免运费
        </button>
        <button
          class="delivery-tab {{deliveryType === 'delivery' ? 'is-active' : ''}}"
          data-type="delivery"
          bindtap="selectDeliveryType"
        >
          北京闪送｜运费实算
        </button>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="checkout-notice fade-in">
        <block wx:if="{{deliveryType === 'pickup'}}">
          <text class="notice-main">建议提前一天预订 · 到店自取（09:00 - 19:30）</text>
          <text class="notice-sub">自提门店：{{pickupAddress || '北京市朝阳区芸熙烘焙'}}</text>
        </block>
        <block wx:else>
          <text class="notice-main">北京同城闪送专送 · 运费按收货地址实测</text>
          <text class="notice-sub">商品按门店自提价展示；每日发货 09:00-19:30，当天订单 17:00 截单（须客服确认）</text>
        </block>
      </view>
      <view wx:if="{{errorMessage && isLoggedIn}}" class="checkout-error">{{errorMessage}}</view>
      <view wx:if="{{isLoggedIn && checkoutItems.length && deliveryType === 'delivery'}}" class="address-picker hover-scale fade-in" bindtap="openAddressBook">
        <view>
          <text class="address-picker-label">收货地址</text>
          <text class="address-picker-value">{{selectedAddressText}}</text>
        </view>
        <text class="address-picker-action">选择</text>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="form fade-in">
        <view class="form-field">
          <text class="form-field__label">联系人</text>
          <input placeholder="请输入联系人姓名" value="{{receiverName}}" data-field="receiverName" bindinput="updateField" />
        </view>
        <view class="form-field">
          <text class="form-field__label">手机号</text>
          <input placeholder="请输入 11 位手机号" type="number" maxlength="11" value="{{receiverPhone}}" data-field="receiverPhone" bindinput="updateField" />
        </view>
        <view class="form-field">
          <text class="form-field__label">{{deliveryType === 'delivery' ? '配送地址' : '自提备注'}}</text>
          <input
            placeholder="{{deliveryType === 'delivery' ? '如：小区、楼栋、门牌号' : '如：到店取货说明'}}"
            value="{{deliveryAddress}}"
            data-field="deliveryAddress"
            bindinput="updateField"
          />
        </view>
        <view class="time-grid">
          <picker
            mode="date"
            class="time-grid__date"
            value="{{selectedDateValue}}"
            start="{{dateStartValue}}"
            end="{{dateEndValue}}"
            bindchange="selectExpectDate"
          >
            <view class="time-picker">日期：{{selectedDateValue || '请选择'}}</view>
          </picker>
          <picker mode="selector" value="{{selectedHourIndex}}" range="{{hourOptions}}" bindchange="selectExpectHour">
            <view class="time-picker">小时：{{hourOptions[selectedHourIndex] || '18'}}</view>
          </picker>
          <picker mode="selector" value="{{selectedMinuteIndex}}" range="{{minuteOptions}}" bindchange="selectExpectMinute">
            <view class="time-picker">分钟：{{minuteOptions[selectedMinuteIndex] || '00'}}</view>
          </picker>
        </view>
        <view class="time-preview">期望时间：{{expectTime || '未选择'}}</view>
        <text wx:if="{{isSameDayOrder}}" class="time-preview">当天订单需客服确认制作与履约安排，不承诺即时制作或即时配送。</text>
        <view class="form-field">
          <text class="form-field__label">订单备注</text>
          <textarea placeholder="如：生日牌文字、忌口等" value="{{remark}}" data-field="remark" bindinput="updateField" />
        </view>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="benefit-panel">
        <view class="benefit-row" bindtap="toggleCouponPanel">
          <text class="benefit-label">优惠券</text>
          <text class="benefit-value">
            {{selectedCouponId ? '已选 1 张' : (availableCoupons.length ? availableCoupons.length + ' 张可用' : '暂无可用')}}
          </text>
          <text class="benefit-arrow">{{showCouponPanel ? '▲' : '▼'}}</text>
        </view>
        <view wx:if="{{showCouponPanel}}" class="coupon-panel">
          <view
            wx:for="{{availableCoupons}}"
            wx:key="couponId"
            class="coupon-option {{item.disabled ? 'disabled' : ''}} {{selectedCouponId === item.couponId ? 'selected' : ''}}"
            data-id="{{item.couponId}}"
            bindtap="selectCoupon"
          >
            <text class="coupon-option-value">-{{item.valueFen / 100}}元</text>
            <text class="coupon-option-title">{{item.title}}（{{item.thresholdFen > 0 ? '满' + item.thresholdFen / 100 + '元可用' : '无门槛'}}）</text>
            <text wx:if="{{orderLocked && selectedCouponId === item.couponId}}" class="coupon-applied">已应用</text>
          </view>
          <view wx:if="{{availableCoupons.length === 0}}" class="coupon-empty">暂无可用优惠券</view>
        </view>
        <view class="benefit-row" bindtap="togglePointsRow">
          <text class="benefit-label">积分抵扣</text>
          <switch checked="{{pointsEnabled}}" disabled="{{orderLocked}}" color="#3D332D" bindchange="onPointsSwitch" />
          <text class="benefit-value">{{orderLocked ? '积分已应用' : '可用 ' + pointsBalance + ' 积分'}}</text>
        </view>
        <text wx:if="{{orderLocked}}" class="benefit-note">积分已应用，取消请先取消订单</text>
        <view class="benefit-row" bindtap="toggleBalanceRow">
          <text class="benefit-label">余额抵扣</text>
          <switch checked="{{balanceEnabled}}" color="#3D332D" bindchange="onBalanceSwitch" />
          <text class="benefit-value">可用 {{balanceFen / 100}} 元</text>
        </view>
      </view>

      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="amount-panel">
        <view class="amount-row"><text>商品金额</text><text>{{goodsFenText}}</text></view>
        <view class="amount-row">
          <text>闪送运费</text>
          <text class="{{deliveryType === 'pickup' ? 'fee-free' : ''}}">{{deliveryFeeText}}</text>
        </view>
        <view wx:if="{{deliveryType === 'delivery' && deliveryQuoteStatus !== 'quoted'}}" class="delivery-guidance">
          <text class="delivery-guidance__title">{{deliveryGuidanceTitle}}</text>
          <text class="delivery-guidance__text">{{deliveryGuidanceText}}</text>
          <button
            wx:if="{{deliveryGuidanceActionText}}"
            class="ghost-button delivery-guidance__action"
            bindtap="handleDeliveryGuidance"
          >{{deliveryGuidanceActionText}}</button>
        </view>
        <view class="amount-row"><text>优惠券</text><text>{{estimateCouponFenText}}</text></view>
        <view class="amount-row"><text>积分抵扣</text><text>{{pointsEnabled ? '提交后计算' : '-'}}</text></view>
        <view class="amount-row"><text>余额抵扣</text><text>{{balanceEnabled ? balanceDeductText : '-'}}</text></view>
        <view class="amount-row amount-total"><text>实付（估算）</text><text>{{estimateRemainFenText}}</text></view>
        <text class="amount-note">运费在支付前确定并一并支付，最终金额以确认页为准</text>
      </view>

      <view wx:if="{{isLoggedIn && checkoutItems.length && pendingBarVisible}}" class="pending-bar">
        <text>您有一笔待支付订单</text>
        <view class="pending-actions">
          <text class="pending-action" bindtap="resumePendingOrder">继续支付</text>
          <text class="pending-action danger" bindtap="cancelPendingOrder">取消订单</text>
        </view>
      </view>
      <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="agreement-row hover-scale fade-in" bindtap="toggleAgreementAccepted">
        <text class="agreement-check {{agreementAccepted ? 'is-checked' : ''}}">{{agreementAccepted ? '✓' : ''}}</text>
        <view class="agreement-copy">
          <text class="agreement-copy__intro">我已阅读并同意</text>
          <view class="agreement-links">
            <text class="agreement-link" data-type="agreement" catchtap="openPolicy">《用户协议》</text>
            <text class="agreement-links__join">和</text>
            <text class="agreement-link" data-type="privacy" catchtap="openPolicy">《隐私政策》</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{isLoggedIn && checkoutItems.length}}" class="checkout-footer">
    <view class="checkout-footer__total">
      <text class="muted">实付（估算）</text>
      <text class="checkout-footer__amount">{{estimateRemainFenText}}</text>
    </view>
    <button
      class="primary-button checkout-footer__submit hover-scale"
      loading="{{submitting}}"
      disabled="{{submitting || !canSubmitOrder}}"
      bindtap="submitOrder"
    >{{submitButtonText}}</button>
  </view>
</view>
