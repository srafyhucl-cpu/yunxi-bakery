/* ==========================================================================
   结算下单页 (Checkout Page) - 现代自然轻食风格重塑
   ========================================================================== */

.checkout-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 220rpx;
}

.checkout-summary,
.delivery-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.checkout-summary {
  padding: 24rpx;
  color: var(--yunxi-text-secondary);
}

.checkout-total {
  color: var(--yunxi-price);
  font-size: 34rpx;
  font-weight: 900;
  white-space: nowrap;
}

/* 配送方式切换 */
button.delivery-tab,
.delivery-tab {
  flex: 1;
  width: auto !important;
  min-width: 0;
  min-height: 84rpx;
  border-radius: var(--yunxi-radius-full);
  background: #FFFFFF;
  color: var(--yunxi-text-secondary);
  border: 1rpx solid var(--yunxi-border);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.delivery-tab.is-active,
.delivery-tab.is-active {
  background: var(--yunxi-brand);
  color: #FFFFFF;
  border-color: var(--yunxi-brand);
  box-shadow: 0 6rpx 16rpx rgba(61, 51, 45, 0.16);
}

button.delivery-tab:active,
.delivery-tab:active {
  opacity: 0.86;
}

.checkout-notice {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  background: transparent;
}

.checkout-error {
  padding: 18rpx 24rpx;
  color: var(--yunxi-deal);
  background: #FDF1EE;
  border: 1rpx solid rgba(186, 78, 61, 0.2);
  border-radius: var(--yunxi-radius-md);
  font-size: 24rpx;
  line-height: 1.45;
}

/* 地址选择器 */
.address-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  line-height: 1.35;
  overflow: hidden;
}

.address-picker:active,
.benefit-row:active,
.coupon-option:active,
.agreement-row:active {
  background: var(--yunxi-surface-alt);
}

/* 无可用券的优惠券行只作信息展示，不提供按下反馈。 */
.benefit-row--static:active {
  background: transparent;
}

.address-picker-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
}

.address-picker-value {
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.address-picker-action {
  color: var(--yunxi-brand);
  font-size: 26rpx;
  font-weight: 800;
}

/* 表单与时间选择 */
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.time-grid {
  flex-wrap: wrap;
  display: flex;
  gap: 16rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}


.time-grid picker.time-grid__date {
  flex: 1 0 100%;
}

/* 可点击的时间选择器：保留输入框外观并给出下拉指示，避免被当成静态文字 */
.time-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  font-size: 26rpx;
  color: var(--yunxi-text-primary);
}

.time-picker__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.time-picker__chevron {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border: solid var(--yunxi-text-muted);
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

/* 只读的期望时间预览：去掉边框与底色，避免被误认为可点击控件 */
.time-preview {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  min-height: auto;
  padding: 16rpx 4rpx 0;
  line-height: 1.5;
}

input,
textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  font-size: 28rpx;
  color: var(--yunxi-text-primary);
}

textarea {
  height: 180rpx;
  min-height: 180rpx;
  padding-top: 24rpx;
}

/* 协议勾选 */
.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-top: 2rpx;
  color: #FFFFFF;
  background: #FFFFFF;
  border: 2rpx solid var(--yunxi-border-medium);
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 800;
  transition: all 0.2s ease;
}

.agreement-check.is-checked {
  background: var(--yunxi-brand);
  border-color: var(--yunxi-brand);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-copy__intro {
  display: block;
}

.agreement-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.agreement-links__join {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--yunxi-text-secondary);
}

.agreement-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--yunxi-brand);
  font-weight: 800;
}

/* 底部结算悬浮栏 */
.checkout-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: none;
  border-top: 1rpx solid var(--yunxi-border);
  box-shadow: 0 -8rpx 28rpx rgba(35, 50, 42, 0.05);
}

.checkout-footer__total {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.checkout-footer__amount {
  color: var(--yunxi-price);
  font-size: 40rpx;
  font-weight: 900;
  white-space: nowrap;
  letter-spacing: 0;
}

/* 底部金额来源说明：让顾客在固定栏就能看到闪送费是否已计入 */
.checkout-footer__note {
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.checkout-footer__submit {
  flex: 0 0 250rpx;
  min-width: 250rpx;
}

/* 权益与金额明细面板 */
.benefit-panel,
.amount-panel {
  margin-top: 16rpx;
  padding: 8rpx 28rpx;
  border-radius: var(--yunxi-radius-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.benefit-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  gap: 16rpx;
  line-height: 1.35;
  overflow: hidden;
}

.benefit-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--yunxi-text-primary);
}

.benefit-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--yunxi-text-secondary);
}

.benefit-value.is-muted {
  color: var(--yunxi-text-muted);
}

.asset-switch[disabled] {
  opacity: 0.45;
}

.benefit-arrow {
  font-size: 22rpx;
  color: var(--yunxi-text-subtle);
}

.coupon-panel {
  padding: 8rpx 0 16rpx;
}

.coupon-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: var(--yunxi-radius-md);
  border: 2rpx solid var(--yunxi-border);
  margin-top: 12rpx;
  line-height: 1.35;
  overflow: hidden;
  transition: all 0.2s ease;
}

.coupon-option.selected {
  border-color: var(--yunxi-brand);
  background: var(--yunxi-brand-soft);
}

.coupon-option.disabled {
  opacity: 0.45;
}

.coupon-option-value {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--yunxi-deal);
}

.coupon-applied {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--yunxi-brand);
}

.benefit-note {
  display: block;
  padding: 8rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.coupon-option-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--yunxi-text-primary);
}

.coupon-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--yunxi-text-muted);
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--yunxi-text-secondary);
}

.amount-row.amount-total {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--yunxi-price);
  border-top: 1rpx solid var(--yunxi-border);
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.amount-note {
  display: block;
  padding-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.amount-warning {
  display: block;
  padding: 0 0 16rpx;
  color: var(--yunxi-deal);
  font-size: 22rpx;
  line-height: 1.45;
}

.delivery-guidance {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 8rpx 0 4rpx;
  padding: 14rpx 16rpx;
  background: #FFF8F1;
  border: 1rpx solid #F1D4B7;
  border-radius: var(--yunxi-radius-sm);
}

.delivery-guidance__title {
  color: var(--yunxi-text-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.delivery-guidance__text {
  color: var(--yunxi-text-muted);
  font-size: 21rpx;
  line-height: 1.45;
}

button.delivery-guidance__action {
  align-self: flex-start;
  min-width: 144rpx;
  min-height: 88rpx;
  margin: 4rpx 0 0;
  padding: 0 18rpx;
  color: var(--yunxi-text-primary);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border-strong);
  font-size: 22rpx;
}

/* 待支付提示 */
.pending-bar {
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: var(--yunxi-radius-md);
  background: var(--yunxi-gold-soft);
  border: 1rpx solid rgba(194, 155, 99, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #7A5524;
}

.pending-actions {
  display: flex;
  gap: 24rpx;
}

.pending-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  min-height: 52rpx;
  color: var(--yunxi-brand);
  font-weight: 800;
}

.pending-action.danger {
  color: var(--yunxi-deal);
}

.pending-action:active {
  opacity: 0.65;
}

.agreement-link:active {
  opacity: 0.65;
}

/* 结算页按履约决策排序，优惠信息降为次要信息 */
.checkout-page {
  gap: 12rpx;
  padding-top: 16rpx;
}

.checkout-summary {
  padding: 18rpx 20rpx;
  border-radius: var(--yunxi-radius-md);
  box-shadow: none;
}

.checkout-summary__eyebrow,
.checkout-summary__hint {
  display: block;
}

.checkout-summary__eyebrow {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.checkout-summary__hint {
  margin-top: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
}

.checkout-total {
  font-size: 32rpx;
}

.checkout-items {
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
}

.checkout-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.checkout-item:last-child {
  border-bottom: 0;
}

.checkout-item__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.checkout-item__title {
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-item__meta {
  color: var(--yunxi-text-muted);
  font-size: 21rpx;
}

.checkout-item__price {
  flex: 0 0 auto;
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.delivery-tabs {
  gap: 8rpx;
  padding: 4rpx;
  background: var(--yunxi-surface-alt);
  border-radius: var(--yunxi-radius-sm);
}

button.delivery-tab,
.delivery-tab {
  min-width: 0;
  min-height: 92rpx;
  border-radius: 6rpx;
  border-color: transparent;
  font-size: 25rpx;
  line-height: 1.25;
}

button.delivery-tab.is-active,
.delivery-tab.is-active {
  box-shadow: none;
}

.checkout-notice {
  gap: 5rpx;
  padding: 12rpx 4rpx 14rpx;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.address-picker,
.form,
.benefit-panel,
.amount-panel,
.agreement-row {
  border-radius: var(--yunxi-radius-md);
  box-shadow: none;
}

.address-picker {
  padding: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
}

.form {
  gap: 12rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
}

input,
textarea,
.time-picker {
  border-radius: 6rpx;
}

.time-grid {
  gap: 8rpx;
}

.time-picker {
  padding: 0 14rpx;
  font-size: 24rpx;
}

.benefit-panel,
.amount-panel {
  margin-top: 0;
  padding: 4rpx 20rpx;
  border-radius: var(--yunxi-radius-md);
  box-shadow: none;
}

.benefit-row {
  padding: 18rpx 0;
}

.amount-row {
  padding: 13rpx 0;
}

.amount-row.amount-total {
  padding-top: 16rpx;
}

.agreement-row {
  padding: 16rpx 4rpx;
  border: 0;
  background: transparent;
  line-height: 1.5;
}

.checkout-footer {
  gap: 16rpx;
  padding: 12rpx 20rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: #FFFFFF;
  backdrop-filter: none;
  box-shadow: 0 -4rpx 16rpx rgba(61, 51, 45, 0.06);
}

.checkout-footer__amount {
  font-size: 34rpx;
}

.checkout-footer__submit {
  flex-basis: 220rpx;
  min-width: 220rpx;
  border-radius: 6rpx;
}
