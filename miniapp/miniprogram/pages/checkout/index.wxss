/* ==========================================================================
   确认订单 —— 画册式版面（纸色带 + 柔白平面 + 裸字段表单）
   1. 区块按“横向色带”连续铺排，靠底色与留白分层，不做上下都描边的卡片。
   2. 输入控件一律裸字段：透明底、无四边框，只保留 1rpx 底边线。
   3. 配送方式是下划线式双 tab，选中态用墨色 2rpx 底边，不画描边盒子。
   ========================================================================== */

.checkout-page {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 200rpx);
  background: var(--yunxi-page-bg);
}

/* 购买摘要：纸色信息带，标题走 overline */
.checkout-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface-cream);
  border-bottom: 0;
}

.checkout-summary__eyebrow,
.checkout-summary__hint {
  display: block;
}

.checkout-summary__eyebrow {
  color: var(--yunxi-text-secondary);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.16em;
}

.checkout-summary__hint {
  margin-top: 8rpx;
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.checkout-total {
  flex: 0 0 auto;
  color: var(--yunxi-price);
  font-size: 34rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* 商品清单：柔白连续行，行间用 1rpx 细线 */
.checkout-items {
  padding: 0 var(--yunxi-page-gutter);
  background: var(--yunxi-surface);
  border-bottom: 0;
}

.checkout-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.checkout-item:last-child {
  border-bottom: 0;
}

.checkout-item__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.checkout-item__title {
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-item__meta {
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.checkout-item__price {
  flex: 0 0 auto;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* 配送方式：下划线双 tab，选中用墨色 2rpx 底边 */
.delivery-tabs {
  display: flex;
  align-items: stretch;
  gap: 44rpx;
  padding: 24rpx var(--yunxi-page-gutter) 0;
  background: var(--yunxi-surface);
  border-bottom: 0;
}

button.delivery-tab,
.delivery-tab {
  flex: 0 1 auto;
  width: auto !important;
  min-width: 0;
  min-height: 96rpx;
  padding: 0 !important;
  margin: 0 !important;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border: 0;
  border-bottom: 2rpx solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--yunxi-text-muted);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button.delivery-tab.is-active,
.delivery-tab.is-active {
  background: transparent;
  color: var(--yunxi-text-primary);
  border-bottom-color: var(--yunxi-text-primary);
  font-weight: 500;
}

button.delivery-tab:active,
.delivery-tab:active {
  opacity: 0.7;
}

/* 履约提示：纸底留白 + 左侧黄铜细线，不再铺整块底色 */
.checkout-notice {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 26rpx var(--yunxi-page-gutter);
  padding: 2rpx 0 2rpx 22rpx;
  border-left: 3rpx solid var(--yunxi-gold);
  background: transparent;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-main {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.notice-sub {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.checkout-error {
  padding: 20rpx var(--yunxi-page-gutter);
  color: var(--yunxi-deal);
  background: #FBF0ED;
  border-bottom: 1rpx solid rgba(180, 84, 63, 0.16);
  font-size: 24rpx;
  line-height: 1.45;
}

/* 地址选择：柔白整行，下方 1rpx 细线 */
.address-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 120rpx;
  padding: 22rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface);
  border-bottom: 1rpx solid var(--yunxi-border);
  line-height: 1.4;
  overflow: hidden;
}

.address-picker:active,
.benefit-row:active,
.agreement-row:active {
  background: var(--yunxi-surface-cream);
}

/* 无可用券的优惠券行只作信息展示，不提供按下反馈。 */
.benefit-row--static:active {
  background: transparent;
}

.address-picker-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.16em;
}

.address-picker-value {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 400;
}

.address-picker-action {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--yunxi-brand);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
}

/* 联系人、时间与备注：裸字段表单 */
.form {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 30rpx var(--yunxi-page-gutter) 34rpx;
  background: var(--yunxi-surface);
  border-bottom: 0;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 32rpx;
}

.form-field:last-child {
  margin-bottom: 0;
}

/* 字段名：20rpx 宽字距 overline，放在控件上方 */
.form .form-field__label {
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.16em;
}

/* 裸字段：透明底、无四边框，只保留 1rpx 底边线 */
.form input,
.form textarea {
  width: 100%;
  min-height: 96rpx;
  padding: 0;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--yunxi-text-primary);
  box-sizing: border-box;
}

.form textarea {
  height: 168rpx;
  min-height: 168rpx;
  padding-top: 10rpx;
  line-height: 1.7;
}

/* 时间选择：与输入框同款的裸字段 */
.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx 28rpx;
  margin-bottom: 32rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}

.time-grid picker.time-grid__date {
  flex: 1 0 100%;
}

.time-picker {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 0;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  border-radius: 0;
  font-size: 28rpx;
  color: var(--yunxi-text-primary);
  box-sizing: border-box;
}

.time-picker__label {
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.16em;
}

.time-picker__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 96rpx;
}

.time-picker__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 400;
}

.time-picker__chevron {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border: solid var(--yunxi-text-muted);
  border-width: 0 2rpx 2rpx 0;
  transform: rotate(45deg);
}

/* 只读的期望时间预览，不伪装成输入控件 */
.time-preview {
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  padding: 0 0 24rpx;
  line-height: 1.6;
}

text.time-preview {
  display: block;
  padding: 0 0 24rpx;
  color: var(--yunxi-gold);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 优惠权益与金额明细：柔白平面，密集数据行用细线 */
.benefit-panel,
.amount-panel {
  padding: 0 var(--yunxi-page-gutter);
  background: var(--yunxi-surface);
  border-bottom: 0;
}

.benefit-panel {
  margin-top: 26rpx;
}

.amount-panel {
  border-top: 1rpx solid var(--yunxi-border);
  padding-top: 6rpx;
  padding-bottom: 26rpx;
}

.benefit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  line-height: 1.4;
  overflow: hidden;
}

.benefit-row:last-child {
  border-bottom: 0;
}

.benefit-label {
  flex: 0 0 auto;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.benefit-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  color: var(--yunxi-text-primary);
  font-variant-numeric: tabular-nums;
}

.benefit-value.is-muted {
  color: var(--yunxi-text-muted);
}

.asset-switch[disabled] {
  opacity: 0.45;
}

.benefit-arrow {
  flex: 0 0 auto;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
}

/* 券票：内容单元，允许轻边框；不做阴影 */
.coupon-panel {
  padding: 4rpx 0 20rpx;
}

.coupon-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx;
  margin-top: 10rpx;
  border-radius: var(--yunxi-radius-sm);
  border: 1rpx solid var(--yunxi-border);
  background: var(--yunxi-surface-cream);
  line-height: 1.4;
  overflow: hidden;
}

.coupon-option.selected {
  border-color: var(--yunxi-brand);
  background: var(--yunxi-brand-tint);
}

.coupon-option.disabled {
  opacity: 0.5;
}

.coupon-option-value {
  flex: 0 0 auto;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--yunxi-deal);
  font-variant-numeric: tabular-nums;
}

.coupon-option-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--yunxi-text-primary);
}

.coupon-applied {
  flex: 0 0 auto;
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: var(--yunxi-brand);
}

.coupon-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--yunxi-text-muted);
}

.benefit-note {
  display: block;
  padding: 8rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

/* 金额明细：label 弱、value 强 */
.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
  color: var(--yunxi-text-secondary);
}

.amount-row > text:last-child {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.amount-row.amount-total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--yunxi-border);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--yunxi-text-primary);
}

.amount-row.amount-total > text:last-child {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--yunxi-price);
}

.amount-note {
  display: block;
  padding: 10rpx 0 4rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
  line-height: 1.6;
}

.amount-warning {
  display: block;
  padding: 0 0 16rpx;
  color: var(--yunxi-deal);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 运费引导：纸色提示块，左侧黄铜细线 */
.delivery-guidance {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 10rpx 0 14rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 3rpx solid var(--yunxi-gold);
  background: transparent;
}

.delivery-guidance__title {
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 500;
}

.delivery-guidance__text {
  color: var(--yunxi-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 次级动作：纯文字链接，不再画描边盒子 */
button.delivery-guidance__action {
  align-self: flex-start;
  min-width: 0;
  min-height: 88rpx;
  margin: 4rpx 0 0;
  padding: 0 0 2rpx;
  color: var(--yunxi-brand);
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-brand);
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}

/* 待支付提示：警示奶油带 */
.pending-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 18rpx var(--yunxi-page-gutter);
  background: #FBF4E7;
  border-bottom: 1rpx solid rgba(176, 138, 90, 0.2);
  font-size: 24rpx;
  color: #7A5524;
}

.pending-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.pending-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 8rpx;
  color: var(--yunxi-brand);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.pending-action.danger {
  color: var(--yunxi-deal);
}

.pending-action:active {
  opacity: 0.65;
}

/* 协议：纸色行，链接保留 88rpx 触控区 */
.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 22rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface-cream);
  border-bottom: 0;
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  color: #FFFFFF;
  background: transparent;
  border: 1rpx solid var(--yunxi-border-medium);
  border-radius: var(--yunxi-radius-sm);
  font-size: 18rpx;
  font-weight: 500;
}

.agreement-check.is-checked {
  background: var(--yunxi-brand);
  border-color: var(--yunxi-brand);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--yunxi-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.agreement-copy__intro {
  display: block;
}

.agreement-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.agreement-links__join {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--yunxi-text-secondary);
}

.agreement-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--yunxi-brand);
  font-weight: 400;
  letter-spacing: 0.04em;
  text-decoration: underline;
}

.agreement-link:active {
  opacity: 0.65;
}

/* 固定提交栏：纸白平面 + 深林绿主按钮，允许阴影 */
.checkout-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx var(--yunxi-page-gutter) calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--yunxi-surface);
  border-top: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-floating-shadow);
}

.checkout-footer__total {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.checkout-footer__total .muted {
  color: var(--yunxi-text-secondary);
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 0.12em;
}

.checkout-footer__amount {
  color: var(--yunxi-price);
  font-size: 36rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  letter-spacing: 0;
}

/* 底部金额来源说明：让顾客在固定栏就能看到闪送费是否已计入 */
.checkout-footer__note {
  overflow: hidden;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.checkout-footer__submit {
  flex: 0 0 240rpx;
  min-width: 240rpx;
  height: 96rpx;
  min-height: 96rpx;
  border-radius: var(--yunxi-radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}
