.home-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 18rpx;
  padding-bottom: var(--yunxi-page-bottom-space);
}

.notice-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  margin-top: -4rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(237, 247, 232, 0.88);
  border-color: rgba(75, 129, 72, 0.1);
  box-shadow: none;
}

.notice-icon {
  color: var(--yunxi-accent-deep);
  font-weight: 700;
  font-size: 28rpx;
}

.notice-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6e806f;
}

.home-hero {
  position: relative;
  height: 330rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 82% 20%, rgba(255, 255, 255, 0.86), transparent 20%),
    radial-gradient(circle at 96% 92%, rgba(108, 154, 99, 0.25), transparent 30%),
    linear-gradient(112deg, #4A7A41 0%, #6C9A63 45%, #F4F1EB 100%);
  border: 0;
  box-shadow: 0 28rpx 62rpx rgba(108, 154, 99, 0.18);
}

.home-hero__swiper,
.home-hero__slide,
.home-hero__fallback,
.home-hero__image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-hero__slide,
.home-hero__fallback {
  position: relative;
  overflow: hidden;
}

.home-hero__image {
  border-radius: 38rpx;
}

.home-hero__slide::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  height: auto;
  background:
    linear-gradient(90deg, rgba(36, 58, 40, 0.46), rgba(49, 93, 53, 0.18) 48%, transparent),
    linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(36, 58, 40, 0.08));
  pointer-events: none;
}

.home-hero__copy {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 64%;
  padding: 38rpx 0 28rpx 34rpx;
  color: #fff9f0;
}

.home-hero__eyebrow {
  font-size: 18rpx;
  letter-spacing: 0.18em;
  opacity: 0.78;
}

.home-hero__title {
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
}

.home-hero__desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 249, 239, 0.82);
}

.home-hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 2rpx;
}

.home-hero__badge {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  color: #315d35;
  background: rgba(244, 250, 241, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.home-hero__tap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  min-height: 88rpx;
  margin-top: 2rpx;
  color: #315d35;
  background: linear-gradient(180deg, #ffffff, #d8efcf);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(49, 93, 53, 0.16);
}



.quick-link-grid {
  display: flex;
  gap: 10rpx;
  margin-top: -2rpx;
}

.quick-link-card {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 88rpx;
  padding: 10rpx 14rpx;
  border-color: rgba(44, 37, 32, 0.1);
  border-radius: 999rpx;
  background: transparent;
}

.quick-link-card__icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  font-size: 12rpx;
}

.quick-link-card__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.quick-link-card__title {
  color: var(--yunxi-text-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.quick-link-card__subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 18rpx;
}

.quick-link-card__arrow {
  display: flex;
  color: rgba(169, 122, 65, 0.62);
  font-size: 24rpx;
  line-height: 1;
}

.member-promo {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  min-height: 138rpx;
  padding: 18rpx 20rpx 18rpx 24rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 84% 12%, rgba(255, 255, 255, 0.78), transparent 24%),
    linear-gradient(135deg, rgba(108, 154, 99, 0.96), rgba(74, 122, 65, 0.88));
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(108, 154, 99, 0.15);
}

.member-promo__mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #315d35;
  background: linear-gradient(135deg, #ffffff, #d8efcf);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(49, 93, 53, 0.2);
  font-size: 34rpx;
  font-weight: 900;
}

.member-promo__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.member-promo__kicker {
  font-size: 18rpx;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.76);
}

.member-promo__title {
  font-size: 31rpx;
  font-weight: 800;
}

.member-promo__subtitle {
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.member-promo__action {
  flex: 0 0 auto;
  min-width: 140rpx;
  padding: 16rpx 20rpx;
  color: #315d35;
  background: linear-gradient(180deg, #ffffff, #d8efcf);
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(49, 93, 53, 0.16);
}

.service-notices {
  padding: 2rpx 22rpx;
  border-radius: 22rpx;
  background: transparent;
}

.service-notice {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 12rpx;
  border-bottom: 1rpx solid rgba(75, 129, 72, 0.1);
}

.service-notice:last-child {
  border-bottom: 0;
}

.service-notice__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--yunxi-accent);
}

.service-notice__title {
  flex: 1;
  color: var(--yunxi-text-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.service-notice__action {
  min-width: 108rpx;
  padding: 9rpx 14rpx;
  color: var(--yunxi-accent-deep);
  background: rgba(237, 247, 232, 0.86);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.shelf {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.shelf-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 2rpx;
}

.shelf-head__eyebrow,
.shelf-head__title,
.shelf-head__subtitle {
  display: block;
}

.shelf-head__eyebrow {
  margin-bottom: 6rpx;
  color: rgba(63, 122, 66, 0.78);
  font-size: 18rpx;
  letter-spacing: 0.18em;
}

.shelf-head__title {
  color: var(--yunxi-text-primary);
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.shelf-head__subtitle {
  margin-top: 6rpx;
  color: var(--yunxi-text-secondary);
  font-size: 22rpx;
}

.shelf-head__link {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 4rpx 0 18rpx;
  color: var(--yunxi-accent-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.product-card {
  flex: 0 0 calc((100% - 12rpx) / 2);
  width: calc((100% - 12rpx) / 2);
  min-width: 0;
  min-height: 414rpx;
  overflow: hidden;
  border: 0;
  border-radius: 32rpx;
  background: transparent;
}

.product-card:active {
  transform: translateY(2rpx);
  opacity: 0.96;
}

.product-image {
  height: 212rpx;
  border-radius: 28rpx 28rpx 0 0;
}

.product-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  color: #315d35;
  background: rgba(237, 247, 232, 0.9);
  border: 1rpx solid rgba(75, 129, 72, 0.14);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.product-image::before,
.product-image::after {
  display: none;
}

.product-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 14rpx 16rpx 18rpx;
}

.product-title {
  display: block;
  min-height: 64rpx;
  font-size: 25rpx;
  line-height: 1.34;
  color: var(--yunxi-text-primary);
  font-weight: 700;
}

.product-sold {
  display: block;
  min-height: 30rpx;
  margin-top: 8rpx;
  color: #9d8468;
  font-size: 21rpx;
}

.product-price {
  display: block;
  margin-top: 10rpx;
  color: #3f7a42;
  font-size: 34rpx;
  font-weight: 900;
}


