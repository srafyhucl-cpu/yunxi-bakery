<view class="page-shell page-shell--tabbar" style="{{layoutStyle}}">
  <view class="page-fixed-safe"></view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page home-page">

      <block wx:for="{{blocks}}" wx:key="id">
        <view wx:if="{{item.type === 'noticeBar'}}" class="notice-bar glass-panel hover-scale">
          <text class="notice-icon"></text>
          <text class="notice-text">{{item.props.text}}</text>
        </view>

        <view wx:elif="{{item.type === 'heroCarousel'}}" class="home-hero fade-in hover-scale">
          <swiper
            class="home-hero__swiper"
            circular
            autoplay="{{item.heroAutoplay}}"
            interval="{{item.heroIntervalMs}}"
            indicator-dots="{{item.heroItems.length > 1}}"
            indicator-active-color="#c9a56a"
            indicator-color="rgba(111, 77, 47, 0.22)"
          >
            <swiper-item wx:for="{{item.heroItems}}" wx:key="id" wx:for-item="slide">
              <view class="home-hero__slide" data-slide-id="{{slide.id}}" data-link-type="{{slide.linkType}}" data-link-target="{{slide.linkTarget}}" bindtap="handleHeroTap">
                <image wx:if="{{slide.imageUrl && !slide.imageFailed}}" class="home-hero__image" src="{{slide.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onHeroImageError" />
                <view wx:else class="home-hero__fallback"></view>
                <view class="home-hero__copy">
                  <text class="home-hero__eyebrow">{{slide.eyebrow}}</text>
                  <text class="home-hero__title">{{slide.title}}</text>
                  <text class="home-hero__desc">{{slide.subtitle}}</text>
                  <view wx:if="{{slide.badges.length}}" class="home-hero__badges">
                    <text wx:for="{{slide.badges}}" wx:key="*this" wx:for-item="badge" class="home-hero__badge">{{badge}}</text>
                  </view>
                  <text wx:if="{{slide.linkType !== 'none'}}" class="home-hero__tap">去看看</text>
                </view>
              </view>
            </swiper-item>
          </swiper>
        </view>

        <view wx:elif="{{item.type === 'quickLinks'}}" class="quick-link-grid">
          <view
            wx:for="{{item.quickLinkItems}}"
            wx:key="id"
            wx:for-item="link"
            class="quick-link-card glass-panel hover-scale"
            data-link-type="{{link.linkType}}"
            data-link-target="{{link.linkTarget}}"
            bindtap="handleBlockAction"
          >
            <view class="quick-link-card__icon bakery-action-icon">{{link.iconText}}</view>
            <view class="quick-link-card__copy">
              <text class="quick-link-card__title">{{link.title}}</text>
              <text class="quick-link-card__subtitle">{{link.subtitle}}</text>
            </view>
            <text class="quick-link-card__arrow">›</text>
          </view>
        </view>

        <view
          wx:elif="{{item.type === 'membershipBanner'}}"
          class="member-promo hover-scale fade-in shimmer-sweep"
          bindtap="navigateToProfile"
        >
          <view class="member-promo__mark">
            <text>Y</text>
          </view>
          <view class="member-promo__copy">
            <text class="member-promo__kicker">芸熙会员</text>
            <text class="member-promo__title">{{item.props.title}}</text>
            <text class="member-promo__subtitle">{{item.props.subtitle}}</text>
          </view>
          <view class="member-promo__action">{{item.props.actionText}}</view>
        </view>

        <view wx:elif="{{item.type === 'noticeList'}}" class="service-notices glass-panel fade-in">
          <view
            wx:for="{{item.noticeItems}}"
            wx:key="id"
            wx:for-item="notice"
            class="service-notice"
            data-link-type="{{notice.linkType}}"
            data-link-target="{{notice.linkTarget}}"
            bindtap="handleBlockAction"
          >
            <text class="service-notice__dot"></text>
            <text class="service-notice__title">{{notice.title}}</text>
            <text class="service-notice__action">{{notice.actionText}}</text>
          </view>
        </view>

        <view wx:elif="{{item.type === 'productShelf'}}" class="shelf">
          <view class="shelf-head">
            <view class="shelf-head__copy">
              <text class="shelf-head__eyebrow">今日鲜制</text>
              <text class="shelf-head__title">{{item.props.title}}</text>
              <text wx:if="{{item.props.subtitle}}" class="shelf-head__subtitle">{{item.props.subtitle}}</text>
            </view>
            <text class="shelf-head__link" bindtap="navigateToProducts">查看更多</text>
          </view>
          <view class="product-grid">
            <view
              wx:for="{{item.products}}"
              wx:for-item="product"
              wx:key="id"
              class="product-card glass-panel hover-scale stagger-fade-in"
              style="animation-delay: {{index * 0.05}}s"
              data-id="{{product.id}}"
              bindtap="openProduct"
              >
                <view class="product-image bakery-photo {{product.imageClass}}">
                  <view class="product-badge">{{product.badgeText}}</view>
                  <image wx:if="{{product.imageUrl && !product.imageFailed}}" class="product-cover" src="{{product.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-id="{{product.id}}" binderror="onHomeProductImageError" />
                  <view wx:else class="yunxi-image-fallback">
                    <text class="yunxi-image-fallback__mark">芸</text>
                  </view>
                </view>
              <view class="product-info">
                <text class="product-title">{{product.title}}</text>
                <text wx:if="{{product.deliveryTip}}" class="product-tip">{{product.deliveryTip}}</text>
                <view class="product-bottom-row">
                  <text class="product-price">{{product.priceText}}</text>
                </view>
                <view
                  class="product-action {{product.isUnavailable ? 'is-muted' : ''}}"
                  data-id="{{product.id}}"
                  catchtap="quickAddHomeProduct"
                >{{product.actionText}}</view>
                <text class="product-detail-link">查看详情 ›</text>
              </view>
            </view>
          </view>
        </view>

      </block>

      <view class="shop-promise-card glass-panel fade-in">
        <view class="shop-promise-item">
          <text class="shop-promise-icon">预</text>
          <view class="shop-promise-text">
            <text class="shop-promise-title">提前1天预订</text>
            <text class="shop-promise-desc">当天制作 次日自取或配送</text>
          </view>
        </view>
        <view class="shop-promise-divider"></view>
        <view class="shop-promise-item">
          <text class="shop-promise-icon">送</text>
          <view class="shop-promise-text">
            <text class="shop-promise-title">北京闪送</text>
            <text class="shop-promise-desc">运费按地址单独计算</text>
          </view>
        </view>
        <view class="shop-promise-divider"></view>
        <view class="shop-promise-item">
          <text class="shop-promise-icon">时</text>
          <view class="shop-promise-text">
            <text class="shop-promise-title">09:00-19:30</text>
            <text class="shop-promise-desc">当天订单 17:00 前咨询</text>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>
  <view wx:if="{{cartBarVisible}}" class="home-cart-bar">
    <view class="home-cart-bar__copy" bindtap="goToCart">
      <text class="home-cart-bar__label">预订单</text>
      <text class="home-cart-bar__meta">{{cartSummaryText}}</text>
    </view>
    <text class="home-cart-bar__amount">{{cartTotalText}}</text>
    <button class="primary-button home-cart-bar__submit" bindtap="goCheckout">去结算</button>
  </view>
</view>
