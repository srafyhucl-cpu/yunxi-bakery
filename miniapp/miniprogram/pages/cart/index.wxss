.cart-page {
  padding: 24rpx 24rpx var(--yunxi-fixed-action-space);
  background: #faf8f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 580rpx;
  color: #728073;
  gap: 16rpx;
  padding: 40rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  font-size: 72rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 32rpx rgba(74, 122, 65, 0.04);
  border: 1rpx solid rgba(74, 122, 65, 0.06);
  margin-bottom: 24rpx;
}

.empty-title {
  color: #243a28;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.empty-action {
  min-width: 240rpx;
  margin-top: 24rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.cart-item {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 122, 65, 0.02);
  border: 1rpx solid rgba(74, 122, 65, 0.04);
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.cart-item:active {
  transform: scale(0.995);
}

.cart-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 99rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #6c9a63, #4a7a41);
  box-shadow: 0 6rpx 14rpx rgba(74, 122, 65, 0.16);
  flex-shrink: 0;
}

.cart-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cart-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 144rpx;
  min-width: 0;
}

.cart-info__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.cart-info__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.cart-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #243a28;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.tag {
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #4a7a41;
  background: rgba(74, 122, 65, 0.08);
  border-radius: 6rpx;
  white-space: nowrap;
}

.cart-price {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-accent-deep);
}

.cart-stepper {
  display: flex;
  align-items: center;
  background: #f8f6f2;
  border-radius: 14rpx;
  padding: 2rpx;
  border: 1rpx solid rgba(74, 122, 65, 0.05);
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #556056;
  border-radius: 10rpx;
  transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.stepper-btn:active {
  background: rgba(74, 122, 65, 0.08);
  color: #243a28;
  transform: scale(0.9);
}

.stepper-val {
  min-width: 56rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #243a28;
}

.cart-footer {
  position: fixed;
  right: 0;
  bottom: var(--yunxi-tabbar-occupied-height);
  left: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 36rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(74, 122, 65, 0.06);
  box-shadow: 0 -8rpx 32rpx rgba(74, 122, 65, 0.03);
  z-index: 100;
}

.cart-footer > view {
  flex: 1;
  min-width: 0;
}

.cart-footer .primary-button {
  flex: 0 0 250rpx;
  min-width: 250rpx;
  box-shadow: 0 8rpx 20rpx rgba(74, 122, 65, 0.15);
}

.cart-total {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--yunxi-accent-deep);
}

.bakery-section-heading {
  margin: 48rpx 8rpx 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #243a28;
}

.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.recommend-card {
  flex: 0 0 calc((100% - 20rpx) / 2);
  width: calc((100% - 20rpx) / 2);
  min-width: 0;
  padding: 0 0 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(74, 122, 65, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(108, 154, 99, 0.01);
  overflow: hidden;
  box-sizing: border-box;
}

.recommend-image {
  width: 100%;
  height: 252rpx;
  overflow: hidden;
}

.recommend-name {
  display: block;
  min-height: 80rpx;
  padding: 18rpx 18rpx 0;
  color: #243a28;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommend-sold {
  display: block;
  padding: 8rpx 18rpx 0;
  color: #9cb09e;
  font-size: 21rpx;
  font-weight: 600;
}

.recommend-card .cart-price {
  display: block;
  padding: 10rpx 18rpx 0;
  font-size: 28rpx;
  font-weight: 800;
}

.recommend-bag {
  width: 48rpx;
  height: 48rpx;
  margin: -10rpx 18rpx 0 auto;
  border-radius: 99rpx;
  background: linear-gradient(135deg, #6c9a63, #4a7a41);
  box-shadow: 0 6rpx 14rpx rgba(74, 122, 65, 0.16);
  position: relative;
  transition: all 0.2s ease;
}

.recommend-bag:active {
  transform: scale(0.9);
}

.recommend-bag::before {
  content: "";
  position: absolute;
  inset: 14rpx 12rpx 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-top-width: 3rpx;
  border-radius: 4rpx 4rpx 8rpx 8rpx;
}

.recommend-bag::after {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 10rpx;
  height: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}
