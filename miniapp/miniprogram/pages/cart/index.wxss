/* ==========================================================================
   购物车页 (Shopping Cart Page) - 现代自然轻食风格重塑
   ========================================================================== */

.cart-page {
  padding: 20rpx 24rpx var(--yunxi-fixed-action-space);
  background: var(--yunxi-page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 购物车商品列表 */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.cart-item {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--yunxi-radius-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
}

.cart-item:active {
  transform: scale(0.98);
}

.cart-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  box-shadow: 0 4rpx 12rpx rgba(61, 51, 45, 0.16);
  flex-shrink: 0;
}

.cart-image {
  width: 156rpx;
  height: 156rpx;
  border-radius: var(--yunxi-radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--yunxi-surface-alt);
}

.cart-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 156rpx;
  min-width: 0;
  padding: 4rpx 0;
}

.cart-info__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.cart-info__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.cart-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.tag {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--yunxi-brand);
  background: var(--yunxi-brand-soft);
  border-radius: var(--yunxi-radius-full);
  white-space: nowrap;
}

.cart-price {
  font-size: 32rpx;
  color: var(--yunxi-price);
  font-weight: 900;
  letter-spacing: 0;
}

.cart-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
  transition: all 0.15s ease;
}

.stepper-btn:active {
  transform: scale(0.9);
}

.stepper-btn--minus {
  color: var(--yunxi-brand);
  background: #ffffff;
  border: 2rpx solid var(--yunxi-border-medium);
}

.stepper-btn--plus {
  color: #ffffff;
  background: var(--yunxi-brand);
  border: 2rpx solid var(--yunxi-brand);
}

.stepper-val {
  min-width: 48rpx;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

/* 底部结算悬浮条 */
.cart-footer {
  position: fixed;
  right: 0;
  bottom: var(--yunxi-tabbar-occupied-height);
  left: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 36rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: none;
  border-top: 1rpx solid var(--yunxi-border);
  box-shadow: 0 -8rpx 28rpx rgba(35, 50, 42, 0.05);
  z-index: 100;
}

.cart-footer > view {
  flex: 1;
  min-width: 0;
}

.cart-footer .primary-button {
  flex: 0 0 240rpx;
  width: 240rpx !important;
  min-width: 240rpx;
  height: 84rpx;
  min-height: 84rpx;
  font-size: 28rpx;
}

.cart-total {
  display: block;
  margin-top: 4rpx;
  font-size: 40rpx;
  color: var(--yunxi-price);
  font-weight: 900;
  white-space: nowrap;
  letter-spacing: 0;
}

.bakery-section-heading {
  margin: 48rpx 8rpx 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

/* 推荐商品流 */
.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.recommend-card {
  flex: 0 0 calc((100% - 20rpx) / 2);
  width: calc((100% - 20rpx) / 2);
  min-width: 0;
  padding: 0 0 20rpx;
  overflow: hidden;
  border-radius: var(--yunxi-radius-md);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  box-sizing: border-box;
}

.recommend-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--yunxi-surface-alt);
}

.recommend-name {
  display: block;
  min-height: 74rpx;
  padding: 16rpx 16rpx 0;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommend-sold {
  display: block;
  padding: 6rpx 16rpx 0;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.recommend-card .cart-price {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 8rpx 16rpx 0;
}

.recommend-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 64rpx;
  padding: 0 14rpx;
  overflow: hidden;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.recommend-action:active {
  transform: scale(0.94);
  opacity: 0.88;
}

.recommend-action.is-muted {
  color: var(--yunxi-text-muted);
  background: var(--yunxi-surface-alt);
}

/* 购物车只保留购买决策需要的信息 */
.cart-page {
  padding: 20rpx 20rpx var(--yunxi-fixed-action-space);
}

.cart-list {
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.cart-item {
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--yunxi-radius-md);
  box-shadow: none;
}

.cart-check {
  width: 32rpx;
  height: 32rpx;
  box-shadow: none;
}

.cart-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--yunxi-radius-sm);
}

.cart-info {
  min-height: 132rpx;
}

.tag {
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  background: var(--yunxi-gold-soft);
  color: #7A5524;
}

.cart-footer {
  bottom: var(--yunxi-tabbar-occupied-height);
  padding: 14rpx 20rpx;
  background: #FFFFFF;
  backdrop-filter: none;
  box-shadow: 0 -4rpx 16rpx rgba(61, 51, 45, 0.06);
}

.cart-footer .primary-button {
  width: 220rpx !important;
  min-width: 220rpx;
  height: 76rpx;
  min-height: 76rpx;
  border-radius: 6rpx;
}

.cart-total {
  font-size: 34rpx;
}

.bakery-section-heading {
  justify-content: flex-start;
  margin: 36rpx 0 16rpx;
  font-size: 28rpx;
  letter-spacing: 0;
}

.bakery-section-heading::before,
.bakery-section-heading::after {
  display: none;
}

.recommend-card {
  border-radius: var(--yunxi-radius-sm);
  box-shadow: none;
}
