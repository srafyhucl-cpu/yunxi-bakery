.policy-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.policy-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 28rpx;
}

.policy-title {
  color: var(--yunxi-text-primary);
  font-size: 40rpx;
  font-weight: 900;
}

.policy-subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
}

.policy-card {
  padding: 32rpx 28rpx;
}

.policy-content {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
