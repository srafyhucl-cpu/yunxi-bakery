<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <button class="page-nav-back" bindtap="goBack" disabled="{{submitting}}" aria-label="返回">
      <text class="page-nav-back__icon"></text>
    </button>
    <view class="page-fixed-safe__title">群内登记</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page group-registration-page">
      <view class="registration-hero bakery-panel">
        <text class="registration-kicker">{{groupName || '芸熙烘焙客户群'}}</text>
        <text class="registration-title">{{campaignTitle}}</text>
        <text class="registration-copy">填写后由门店客服确认，取货/配送安排以确认结果为准。</text>
      </view>

      <session-notice
        wx:if="{{loginStateText}}"
        status-text="{{sessionView.statusText}}"
        badge-text="{{sessionView.badgeText}}"
        description="{{loginStateText}}"
        action-text="{{loginActionText}}"
        icon-key="{{sessionView.loggedIn ? 'user-check' : 'log-in'}}"
        bind:action="goProfile"
      ></session-notice>

      <view wx:if="{{errorMessage}}" class="registration-error">{{errorMessage}}</view>

      <view wx:if="{{!submitted}}" class="form bakery-panel">
        <view class="form-field">
          <text class="form-field__label">联系人</text>
          <input placeholder="请输入联系人姓名" value="{{customerName}}" data-field="customerName" bindinput="updateField" />
        </view>
        <view class="form-field">
          <text class="form-field__label">手机号</text>
          <input placeholder="请输入 11 位手机号" type="number" maxlength="11" value="{{customerPhone}}" data-field="customerPhone" bindinput="updateField" />
        </view>
        <view class="form-field">
          <text class="form-field__label">登记商品</text>
          <input placeholder="如：草莓奶油蛋糕" value="{{productName}}" data-field="productName" bindinput="updateField" />
        </view>
        <view class="quantity-field">
          <text class="quantity-field__label">数量</text>
          <input
            class="quantity-field__input"
            placeholder="1"
            type="number"
            value="{{quantityText}}"
            data-field="quantityText"
            bindinput="updateField"
          />
        </view>

        <view class="fulfillment-tabs">
          <button
            class="fulfillment-tab {{fulfillmentMethod === 'pickup' ? 'is-active' : ''}}"
            data-method="pickup"
            bindtap="selectFulfillmentMethod"
          >
            到店自提
          </button>
          <button
            class="fulfillment-tab {{fulfillmentMethod === 'delivery' ? 'is-active' : ''}}"
            data-method="delivery"
            bindtap="selectFulfillmentMethod"
          >
            北京闪送
          </button>
        </view>

        <view class="time-grid">
          <picker
            mode="date"
            class="time-grid__date"
            value="{{selectedDateValue}}"
            start="{{dateStartValue}}"
            end="{{dateEndValue}}"
            bindchange="selectDesiredDate"
          >
            <view class="time-picker">
              <text class="time-picker__value">日期：{{selectedDateValue || '请选择'}}</text>
              <text class="time-picker__chevron"></text>
            </view>
          </picker>
          <picker mode="selector" value="{{selectedHourIndex}}" range="{{hourOptions}}" bindchange="selectDesiredHour">
            <view class="time-picker">
              <text class="time-picker__value">小时：{{hourOptions[selectedHourIndex] || '18'}}</text>
              <text class="time-picker__chevron"></text>
            </view>
          </picker>
          <picker mode="selector" value="{{selectedMinuteIndex}}" range="{{minuteOptions}}" bindchange="selectDesiredMinute">
            <view class="time-picker">
              <text class="time-picker__value">分钟：{{minuteOptions[selectedMinuteIndex] || '00'}}</text>
              <text class="time-picker__chevron"></text>
            </view>
          </picker>
        </view>
        <view class="time-preview">期望时间：{{desiredTime || '未选择'}}</view>
        <text wx:if="{{isSameDayRegistration}}" class="time-preview">当天登记由门店客服确认制作与履约安排。</text>

        <view wx:if="{{fulfillmentMethod === 'delivery'}}" class="form-field">
          <text class="form-field__label">配送地址</text>
          <input placeholder="如：小区、楼栋、门牌号" value="{{address}}" data-field="address" bindinput="updateField" />
        </view>
        <text wx:if="{{fulfillmentMethod === 'delivery'}}" class="delivery-fee-hint">北京同城闪送专送，运费按收货地址实测、由顾客承担，客服确认后告知。</text>
        <view class="form-field">
          <text class="form-field__label">备注</text>
          <textarea placeholder="如：生日牌文字、忌口、口味偏好等" value="{{remark}}" data-field="remark" bindinput="updateField" />
        </view>
      </view>

      <view wx:if="{{submitted}}" class="success-panel bakery-panel">
        <view class="success-heading">
          <view class="success-heading__icon">✓</view>
          <view class="success-heading__copy">
            <text class="success-title">登记已提交</text>
            <text class="success-subtitle">门店客服确认后会联系你，请留意客服消息。</text>
          </view>
        </view>
        <view class="success-list">
          <view class="success-row">
            <text>商品</text>
            <text>{{submittedRegistration.productName}}</text>
          </view>
          <view class="success-row">
            <text>数量</text>
            <text>{{submittedRegistration.quantity}}</text>
          </view>
          <view class="success-row">
            <text>期望时间</text>
            <text>{{submittedRegistration.desiredTime}}</text>
          </view>
          <view class="success-row">
            <text>状态</text>
            <text>待客服确认</text>
          </view>
        </view>
      </view>

      <button
        wx:if="{{!submitted}}"
        class="primary-button submit-button"
        loading="{{submitting}}"
        disabled="{{submitting || !canSubmitRegistration}}"
        bindtap="submitRegistration"
      >提交登记</button>
      <view wx:else class="success-actions">
        <button class="primary-button" bindtap="goChat" disabled="{{submitting}}">联系客服</button>
        <button class="ghost-button" bindtap="goHome" disabled="{{submitting}}">返回首页</button>
      </view>
    </view>
  </scroll-view>
</view>
