/* ==========================================================================
   拼团登记页 (Group Registration Page) - 现代自然轻食风格重塑
   ========================================================================== */

.group-registration-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.registration-hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 28rpx;
}

.registration-kicker {
  color: var(--yunxi-brand);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.registration-title {
  color: var(--yunxi-text-primary);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.registration-copy {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.registration-error {
  padding: 18rpx 24rpx;
  color: var(--yunxi-deal);
  background: #FDF1EE;
  border: 1rpx solid rgba(186, 78, 61, 0.2);
  border-radius: var(--yunxi-radius-md);
  font-size: 24rpx;
  line-height: 1.45;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.fulfillment-tabs,
.success-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

button.fulfillment-tab,
.fulfillment-tab {
  flex: 1;
  width: auto !important;
  min-height: 84rpx;
  border-radius: var(--yunxi-radius-sm);
  background: #FFFFFF;
  color: var(--yunxi-text-secondary);
  border: 1rpx solid var(--yunxi-border);
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.fulfillment-tab.is-active,
.fulfillment-tab.is-active {
  background: var(--yunxi-brand);
  color: #FFFFFF;
  border-color: var(--yunxi-brand);
  box-shadow: 0 4rpx 14rpx rgba(61, 51, 45, 0.16);
}

.time-grid {
  display: flex;
  gap: 16rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}

.time-picker,
.time-preview {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  font-size: 26rpx;
  color: var(--yunxi-text-primary);
}

.time-preview {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  min-height: auto;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

input,
textarea {
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  font-size: 28rpx;
  color: var(--yunxi-text-primary);
}

textarea {
  min-height: 180rpx;
  padding-top: 24rpx;
}

.registration-success {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.registration-success-badge {
  display: inline-flex;
  align-self: center;
  padding: 6rpx 18rpx;
  border-radius: var(--yunxi-radius-full);
  background: var(--yunxi-brand-soft);
  color: var(--yunxi-brand);
  font-size: 24rpx;
  font-weight: 800;
}
