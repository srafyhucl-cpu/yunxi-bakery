.group-registration-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.registration-hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
}

.registration-kicker {
  color: var(--yunxi-accent-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.registration-title {
  color: var(--yunxi-text-primary);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.registration-copy {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.registration-error {
  padding: 18rpx 22rpx;
  color: #c0342b;
  background: #fff4f0;
  border: 1rpx solid #f0c1b6;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx;
}

.fulfillment-tabs,
.success-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fulfillment-tab {
  flex: 1;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--yunxi-text-secondary);
  border: 1rpx solid var(--yunxi-border);
  font-size: 28rpx;
  font-weight: 700;
}

.fulfillment-tab.is-active {
  background: linear-gradient(180deg, #8bbf74 0%, #3f7a42 100%);
  color: #ffffff;
  border-color: transparent;
}

.time-grid {
  display: flex;
  gap: 16rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}

.time-picker,
.time-preview {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fbf6;
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 18rpx;
  font-size: 26rpx;
}

.time-preview {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  min-height: auto;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

input,
textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fbf6;
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 18rpx;
  font-size: 28rpx;
}

textarea {
  min-height: 180rpx;
  padding-top: 24rpx;
}

.submit-button {
  margin-top: 26rpx;
}

.success-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 26rpx;
}

.success-title {
  color: var(--yunxi-accent-deep);
  font-size: 34rpx;
  font-weight: 900;
}

.success-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.success-row text:last-child {
  max-width: 430rpx;
  color: var(--yunxi-text-primary);
  font-weight: 800;
  text-align: right;
  word-break: break-all;
}

.success-actions {
  margin-top: 26rpx;
}

.success-actions button {
  flex: 1;
}
