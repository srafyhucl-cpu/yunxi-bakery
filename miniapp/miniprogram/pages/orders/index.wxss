/* ==========================================================================
   订单列表 —— 画册式排版（墨色纸面 / 细线分区 / 大留白）
   筛选：下划线式标签，选中墨色 + 2rpx 底边，数量为小号上标文本而非药丸。
   订单：柔白连续分区，40rpx 留白 + 1rpx 分隔线，不做卡片、不用圆角、无阴影。
   状态：20rpx 宽字距文本 + 小圆点；金额：30rpx/500 tabular。
   底部操作行：纸色底，取消订单为文字入口，立即支付为深林绿主按钮。
   ========================================================================== */

.orders-page {
  background: var(--yunxi-page-bg);
}

/* 筛选标签条：纸白平面条，选中项用墨色文字 + 2rpx 底线标识 */
.filter-tabs-bar {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 0;
  background: var(--yunxi-surface);
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  border-radius: 0;
  box-shadow: none;
}

.filter-tab-item {
  position: relative;
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 4rpx 18rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.2;
}

.filter-tab-item:active {
  opacity: 0.6;
}

.filter-tab-content {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  max-width: 100%;
}

.filter-tab-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 数量：小号上标文本，去掉药丸底块 */
.filter-tab-badge {
  position: relative;
  top: -8rpx;
  flex-shrink: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
}

.filter-tab-item.is-active {
  color: var(--yunxi-text-primary);
  font-weight: 500;
}

.filter-tab-item.is-active .filter-tab-badge {
  color: var(--yunxi-gold);
}

/* 选中下划线：2rpx 墨色底线 */
.filter-tab-indicator {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 2rpx;
  margin-left: -20rpx;
  background: var(--yunxi-text-primary);
  border-radius: 0;
}

/* 订单列表：柔白连续分区，订单之间只用 1rpx 细线 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--yunxi-surface);
  border-bottom: 1rpx solid var(--yunxi-border);
}

.order-card {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 var(--yunxi-page-gutter);
  overflow: hidden;
  background: var(--yunxi-surface);
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  border-radius: 0;
  box-shadow: none;
  line-height: 1.5;
}

.order-card:last-child {
  border-bottom: 0;
}

.order-card:active {
  background: var(--yunxi-surface-cream);
}

/* 状态行：订单号与订单状态，40rpx 留白起手 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 40rpx 0 0;
}

.order-id-block {
  display: flex;
  flex: 1;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.order-id-label {
  flex-shrink: 0;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.16em;
  white-space: nowrap;
}

.order-id {
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-secondary);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status-group {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 14rpx;
}

/* 状态圆点：黄铜小点，与宽字距状态文本搭配 */
.order-status-dot {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--yunxi-gold);
}

.payment-status {
  flex-shrink: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.16em;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  color: var(--yunxi-text-primary);
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.16em;
  white-space: nowrap;
}

/* 商品信息区：标题 28rpx/500，正文 26rpx/400/1.7 */
.order-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx 0 0;
}

.order-title {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: 0.01em;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.order-meta__line {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.7;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 金额与时间行 */
.order-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0 40rpx;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
}

.order-created {
  min-width: 0;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-footer-right {
  display: flex;
  flex-shrink: 0;
  align-items: baseline;
  gap: 16rpx;
}

.order-total {
  color: var(--yunxi-price);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* 详情入口：整卡可点，这里只做文字层级与箭头提示 */
.order-link {
  display: inline-flex;
  align-items: center;
  padding-left: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.order-link::after {
  content: "";
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-left: 10rpx;
  border-right: 1rpx solid var(--yunxi-text-subtle);
  border-bottom: 1rpx solid var(--yunxi-text-subtle);
  transform: rotate(-45deg);
}

/* 操作行：纸色底操作带，随内容流，不做浮层 */
.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  margin-left: calc(var(--yunxi-page-gutter) * -1);
  margin-right: calc(var(--yunxi-page-gutter) * -1);
  padding: 20rpx var(--yunxi-page-gutter);
  background: var(--yunxi-surface-cream);
  border-top: 1rpx solid var(--yunxi-border);
}

/* 需要带页面作用域压过 app.wxss 的 button:not([size="mini"]) 重置，否则背景、内边距与触控高度都会被清零。 */
.page button.order-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 176rpx;
  height: 96rpx;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: 2rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

/* 主操作：深林绿实心主按钮 */
.page button.order-action-primary {
  color: #F7F4EC;
  background: var(--yunxi-brand);
  border: 1rpx solid var(--yunxi-brand);
  box-shadow: none;
}

/* 次操作：纯文字入口，不画框 */
.page button.order-action-secondary {
  color: var(--yunxi-text-secondary);
  background: transparent;
  border: 1rpx solid transparent;
}

.page button.order-action-button[disabled] {
  color: var(--yunxi-text-subtle) !important;
  background: transparent !important;
  border-color: transparent !important;
  box-shadow: none;
}

/* 列表尾部加载状态 */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx var(--yunxi-page-gutter) 56rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.retry-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 16rpx;
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 400;
  text-decoration: underline;
}

.retry-link:active {
  opacity: 0.65;
}
