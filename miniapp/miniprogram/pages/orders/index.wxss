/* ==========================================================================
   订单列表页 (Orders List Page) - 现代自然轻食风格重塑
   ========================================================================== */

.filter-tabs-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  margin: 0 0 24rpx;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  padding: 6rpx 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(61, 51, 45, 0.04);
  border: 1rpx solid var(--yunxi-border);
}

.filter-tab-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 14rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.filter-tab-content {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.filter-tab-item.is-active {
  color: var(--yunxi-brand);
  font-weight: 800;
}

.filter-tab-item:active {
  background: var(--yunxi-surface-alt);
}

.filter-tab-badge {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--yunxi-surface-alt);
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.filter-tab-item.is-active .filter-tab-badge {
  background: var(--yunxi-brand-soft);
  color: var(--yunxi-brand);
  font-weight: 700;
}

.filter-tab-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 36rpx;
  height: 6rpx;
  background: var(--yunxi-brand);
  border-radius: 999rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  overflow: hidden;
  transition: transform 0.2s ease;
}

.order-card:active {
  transform: scale(0.99);
}

.order-header,
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-id,
.order-meta,
.order-footer {
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
}

.order-id {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

.order-status-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.payment-status {
  padding: 4rpx 14rpx;
  border-radius: var(--yunxi-radius-full);
  background: var(--yunxi-gold-soft);
  color: #7A5524;
  font-size: 20rpx;
  font-weight: 700;
}

.order-status {
  padding: 4rpx 14rpx;
  border-radius: var(--yunxi-radius-full);
  background: var(--yunxi-brand-soft);
  color: var(--yunxi-brand);
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.order-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--yunxi-border);
}

.order-footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-total {
  color: var(--yunxi-price);
  font-size: 34rpx;
  font-weight: 900;
  white-space: nowrap;
  letter-spacing: 0;
}

.order-link {
  color: var(--yunxi-brand);
  font-size: 24rpx;
  font-weight: 800;
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 8rpx;
}

.order-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--yunxi-radius-full);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.order-action-primary {
  color: #FFFFFF;
  background: var(--yunxi-brand);
  box-shadow: 0 6rpx 16rpx rgba(61, 51, 45, 0.16);
}

.order-action-secondary {
  color: var(--yunxi-deal);
  background: #FDF1EE;
  border: 1rpx solid rgba(186, 78, 61, 0.2);
}

.order-action-button[disabled] {
  color: var(--yunxi-text-subtle);
  background: var(--yunxi-surface-alt);
  box-shadow: none;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: var(--yunxi-text-muted);
  font-size: 28rpx;
}

.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 48rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
}

.retry-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  min-height: 52rpx;
  color: var(--yunxi-brand);
  font-weight: 800;
  text-decoration: underline;
}

.retry-link:active {
  opacity: 0.65;
}
