<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <button
      class="page-nav-back"
      bindtap="goBack"
      disabled="{{payingOrderId || cancellingOrderId}}"
      aria-label="返回"
    >
      <text class="page-nav-back__icon"></text>
    </button>
    <view class="page-fixed-safe__title">我的订单</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMore" lower-threshold="120">
    <view class="page">
      <session-notice
        wx:if="{{!sessionView.loggedIn}}"
        status-text="{{sessionView.statusText}}"
        badge-text="{{sessionView.badgeText}}"
        description="{{loginStateText}}"
        action-text="去登录"
        icon-text="订"
        bind:action="goProfile"
      ></session-notice>
      <view wx:if="{{sessionView.loggedIn}}" class="filter-tabs-bar">
        <view
          wx:for="{{filterTabs}}"
          wx:key="key"
          class="filter-tab-item {{item.selected ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectFilter"
        >
          <view class="filter-tab-content">
            <text class="filter-tab-label">{{item.label}}</text>
            <text wx:if="{{item.count > 0}}" class="filter-tab-badge">{{item.count}}</text>
          </view>
          <view class="filter-tab-indicator" wx:if="{{item.selected}}"></view>
        </view>
      </view>
      <view wx:if="{{sessionView.loggedIn && loadFailed && filteredOrders.length === 0}}" class="yunxi-state">
        <view class="yunxi-state__icon">订单</view>
        <text class="yunxi-state__title">订单加载失败</text>
        <text class="yunxi-state__hint">网络开小差了，重试一下吧</text>
        <button class="primary-button yunxi-state__action" bindtap="retryLoad">重新加载</button>
      </view>
      <view wx:elif="{{sessionView.loggedIn && filteredOrders.length === 0}}" class="empty">
        <text>{{loading ? '订单加载中...' : emptyText}}</text>
      </view>
      <view wx:elif="{{sessionView.loggedIn}}" class="order-list">
        <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card yunxi-card" data-id="{{item.id}}" bindtap="openOrder">
          <view class="order-header">
            <text class="order-id">{{item.id}}</text>
            <view class="order-status-group">
              <text class="payment-status">{{item.paymentStatusText}}</text>
              <text class="order-status">{{item.statusText}}</text>
            </view>
          </view>
          <text class="order-title">{{item.itemTitle || '未命名商品'}} × {{item.itemCount || 1}}</text>
          <view class="order-meta">
            <text>{{item.receiverName}} {{item.receiverPhone}}</text>
            <text>{{item.expectTime || '时间待确认'}}</text>
          </view>
          <view class="order-footer">
            <text>{{item.createdAt}}</text>
            <view class="order-footer-right">
              <text class="order-total">{{item.totalText}}</text>
              <text class="order-link">详情</text>
            </view>
          </view>
          <view wx:if="{{item.canPay || item.canCancel}}" class="order-actions">
            <button
              wx:if="{{item.canCancel}}"
              class="order-action-button order-action-secondary"
              data-id="{{item.id}}"
              catchtap="cancelOrder"
              loading="{{cancellingOrderId === item.id}}"
              disabled="{{payingOrderId || cancellingOrderId}}"
            >
              取消订单
            </button>
            <button
              wx:if="{{item.canPay}}"
              class="order-action-button order-action-primary"
              data-id="{{item.id}}"
              catchtap="payOrder"
              loading="{{payingOrderId === item.id}}"
              disabled="{{payingOrderId || cancellingOrderId}}"
            >
              立即支付
            </button>
          </view>
        </view>
      </view>
      <view wx:if="{{sessionView.loggedIn && filteredOrders.length > 0}}" class="list-footer">
        <text wx:if="{{loadingMore}}">正在加载更多订单...</text>
        <text wx:elif="{{loadFailed}}">加载失败，<text bindtap="retryLoad" class="retry-link">点击重试</text></text>
        <text wx:elif="{{!hasMore}}">没有更多订单</text>
      </view>
    </view>
  </scroll-view>
</view>
