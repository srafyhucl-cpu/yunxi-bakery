/* ==========================================================================
   商品分类/点单选购页 (Products Catalog Page) - 现代自然轻食风格重塑
   ========================================================================== */

.products-pinned {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 20rpx 28rpx 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--yunxi-border);
  box-shadow: 0 4rpx 16rpx rgba(61, 51, 45, 0.03);
}

.products-store {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.products-store__copy {
  min-width: 0;
}

.products-store__branch {
  display: block;
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.products-store__meta {
  display: block;
  margin-top: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.3;
}

/* 价格与配送说明 */
.products-service-note {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex: 0 0 auto;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  line-height: 1.35;
  text-align: right;
}

.products-service-note text:first-child {
  color: var(--yunxi-brand);
  font-size: 22rpx;
  font-weight: 700;
}

/* 搜索框 */
.products-search {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  gap: 16rpx;
  padding: 0 28rpx;
  margin: 0;
  background: var(--yunxi-surface-alt);
  border-radius: var(--yunxi-radius-full);
}

.products-search__icon {
  color: var(--yunxi-brand);
  font-size: 28rpx;
  font-weight: 800;
}

.products-search__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.products-search__placeholder {
  color: var(--yunxi-text-subtle);
  font-weight: 500;
}

.products-search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: #FFFFFF;
  background: var(--yunxi-text-subtle);
  /* 触控目标保留 88rpx，可视圆点收到 52rpx，避免清空按钮把搜索栏撑高 */
  box-sizing: border-box;
  border: 18rpx solid transparent;
  background-clip: padding-box;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 1;
}

.products-search__clear:active {
  opacity: 0.72;
}

/* 滚动与分类布局容器 */
.products-scroll-region {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  background: #FFFFFF;
}

.products-degraded {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 28rpx;
  color: var(--yunxi-brand);
  background: var(--yunxi-brand-soft);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.products-degraded:active {
  background: var(--yunxi-surface-alt);
}

/* 骨架屏 */
.products-skeleton {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 18rpx;
  width: 100%;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
}

.products-skeleton__card {
  flex: 0 0 calc((100% - 18rpx) / 2);
  width: calc((100% - 18rpx) / 2);
  min-width: 0;
  padding-bottom: 20rpx;
  overflow: hidden;
}

.products-skeleton__image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--yunxi-radius-md) var(--yunxi-radius-md) 0 0;
}

.products-skeleton__line,
.products-skeleton__line--short {
  height: 26rpx;
  margin: 16rpx 18rpx 0;
  border-radius: 8rpx;
}

.products-skeleton__line--short {
  width: 55%;
}

/* 分类切换时的列表内骨架：只替换列表区域，不遮挡搜索栏和侧栏 */
.products-skeleton--inline {
  padding: 0;
}

/* 双栏联动区域 */
.products-layout {
  display: flex;
  flex: 1;
  align-items: stretch;
  width: 100%;
  min-height: 0;
}

.products-sidebar {
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 100%;
  min-height: 0;
  background: var(--yunxi-page-bg);
  border-right: 1rpx solid var(--yunxi-border);
}

.products-sidebar__item {
  position: relative;
  display: flex;
  min-height: 108rpx;
  padding: 16rpx 14rpx;
  margin: 10rpx 10rpx;
  border-radius: var(--yunxi-radius-sm);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  color: var(--yunxi-text-secondary);
  background: transparent;
  overflow: hidden;
}

.products-sidebar__item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 0;
  background: var(--yunxi-brand);
  border-radius: 99rpx;
  transition: height 0.25s cubic-bezier(0.25, 1, 0.5, 1);
}

.products-sidebar__item.is-active {
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(61, 51, 45, 0.05);
}

.products-sidebar__item.is-active::before {
  height: 40rpx;
}

.products-sidebar__title,
.products-sidebar__subtitle {
  display: block;
}

.products-sidebar__title {
  color: var(--yunxi-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
  transition: color 0.25s ease;
}

.products-sidebar__subtitle {
  margin-top: 4rpx;
  color: var(--yunxi-text-subtle);
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.products-sidebar__item.is-active .products-sidebar__title {
  color: var(--yunxi-text-primary);
  font-weight: 900;
}

.products-sidebar__item.is-active .products-sidebar__subtitle {
  color: var(--yunxi-brand);
}

/* 右侧商品流 */
.products-content-wrapper {
  flex: 1;
  height: 100%;
  min-width: 0;
  min-height: 0;
  display: flex;
}

.products-content {
  flex: 1;
  height: 100%;
  min-width: 0;
  min-height: 0;
  background: #FFFFFF;
}

.products-content__inner {
  padding: 20rpx 18rpx calc(var(--yunxi-tabbar-occupied-height) + 32rpx) 20rpx;
}

.products-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  gap: 4rpx;
  margin-bottom: 14rpx;
}

.products-heading__title {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.products-heading__hint {
  display: block;
  margin-top: 4rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.3;
}


/* 商品卡片网格 */
.products-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.product-card {
  display: flex;
  align-items: stretch;
  width: 100%;
  min-width: 0;
  min-height: 176rpx;
  padding: 14rpx;
  overflow: hidden;
  border-radius: var(--yunxi-radius-md);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card.is-unavailable {
  background: #FBFAF8;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image {
  position: relative;
  flex: 0 0 148rpx;
  width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  border-radius: var(--yunxi-radius-sm);
  background: var(--yunxi-surface-alt);
}

.product-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 2;
}

.product-cover {
  display: block;
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.product-card:active .product-cover {
  transform: scale(1.04);
}

.product-info {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0 2rpx 18rpx;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10rpx;
}

.product-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 0;
  color: var(--yunxi-text-primary);
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.product-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.product-stock {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  color: var(--yunxi-deal);
  background: rgba(186, 78, 61, 0.08);
  border-radius: var(--yunxi-radius-sm);
  font-size: 20rpx;
  font-weight: 800;
}

.product-stock.is-muted {
  color: var(--yunxi-text-muted);
  background: var(--yunxi-surface-alt);
}

.product-hint {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
}

.product-info__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 4rpx;
}

.product-price {
  display: block;
  font-size: 32rpx;
  color: var(--yunxi-price);
  font-weight: 900;
  white-space: nowrap;
}

/* 非卖品没有真实售价：价格位只用次要色表达“非卖品” */
.product-price.is-display-only {
  color: var(--yunxi-text-muted);
  font-size: 26rpx;
  font-weight: 700;
}

.product-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 50rpx;
  padding: 0 18rpx;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(61, 51, 45, 0.16);
}

.product-action-btn.is-muted {
  color: var(--yunxi-text-muted);
  background: var(--yunxi-surface-alt);
  box-shadow: none;
}

.products-empty {
  padding: 80rpx 0 32rpx;
  text-align: center;
}

.products-empty__title {
  display: block;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.products-empty__hint {
  display: block;
  margin-top: 8rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
}

.products-empty__action {
  margin-top: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: var(--yunxi-radius-full);
  background: var(--yunxi-brand);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.products-load-more {
  padding: 40rpx 0 12rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.products-load-more:active,
.products-empty__action:active {
  opacity: 0.7;
}

/* 全局搜索结果面板 */
.products-global-search {
  flex: 1;
  height: 100%;
  min-width: 0;
  min-height: 0;
  background: #FFFFFF;
}

.products-global-search__inner {
  padding: 24rpx 28rpx calc(var(--yunxi-tabbar-occupied-height) + 40rpx);
}

/* 滚动锚点为零高度，仅用于新搜索/新分类时把列表复位到顶部 */
.products-scroll-anchor {
  height: 0;
  overflow: hidden;
}

/* 搜索结果计数只陈述真实命中数，排序口径与分类列表保持一致 */
.products-search-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.products-search-summary__count {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.products-search-summary__hint {
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
}

/* 搜索进行中的过渡提示：有结果时提示刷新，无结果时占位，不改变搜索栏高度 */
.products-search-status {
  margin-bottom: 16rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
}

/* 商品目录以扫描效率为先，分类导航保持轻量 */
.products-pinned {
  gap: 14rpx;
  padding: 18rpx 24rpx 14rpx;
  box-shadow: none;
}

.products-search {
  /* 输入框与清空按钮同高，输入前后搜索栏高度恒定 */
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: var(--yunxi-radius-sm);
}

.products-search__input {
  height: 88rpx;
}

.products-sidebar {
  flex-basis: 176rpx;
  width: 176rpx;
}

.products-sidebar__item {
  min-height: 88rpx;
  padding: 12rpx 10rpx;
  margin: 6rpx 8rpx;
  border-radius: 6rpx;
}

.products-sidebar__item.is-active {
  box-shadow: none;
}

.products-content__inner {
  padding: 16rpx 14rpx calc(var(--yunxi-tabbar-occupied-height) + 28rpx) 16rpx;
}

.products-layout.is-single-category .products-content__inner {
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.products-layout.is-single-category .product-card {
  min-height: 216rpx;
  padding: 18rpx;
}

.products-layout.is-single-category .product-image {
  flex-basis: 164rpx;
  width: 164rpx;
  height: 164rpx;
}

.products-layout.is-single-category .product-info {
  padding-left: 22rpx;
}

.products-layout.is-single-category .product-action-btn {
  min-width: 128rpx;
}

.products-grid {
  gap: 12rpx;
}

.product-card {
  min-height: 200rpx;
  border-radius: var(--yunxi-radius-sm);
  box-shadow: none;
}

.product-image {
  flex-basis: 140rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--yunxi-radius-sm);
}

.product-action-btn {
  min-width: 112rpx;
  height: 88rpx;
  min-height: 88rpx;
  border-radius: 6rpx;
  box-shadow: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.products-empty__action {
  border-radius: 6rpx;
}

/* 商品目录快速预订底栏：把已选金额和结算入口留在商品流内 */
.products-cart-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(env(safe-area-inset-bottom) + 148rpx);
  z-index: 900;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 14rpx 16rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  border-radius: var(--yunxi-radius-md);
  box-shadow: 0 12rpx 28rpx rgba(61, 51, 45, 0.10);
}

.products-cart-bar__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.products-cart-bar__copy:active {
  opacity: 0.72;
}

.products-cart-bar__label {
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.products-cart-bar__meta {
  max-width: 360rpx;
  overflow: hidden;
  color: var(--yunxi-text-muted);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.products-cart-bar__amount {
  flex: 0 0 auto;
  color: var(--yunxi-price);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.products-cart-bar__submit {
  flex: 0 0 auto;
  width: 136rpx !important;
  min-width: 136rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  letter-spacing: 0;
  box-shadow: none;
}

.products-layout .products-content__inner,
.products-global-search__inner {
  padding-bottom: calc(var(--yunxi-tabbar-occupied-height) + 160rpx);
}
