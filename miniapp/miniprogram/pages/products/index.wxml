<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <view class="page-fixed-safe__home" bindtap="goHome" aria-label="返回首页"></view>
    <view class="page-fixed-safe__title">{{storeName}}</view>
  </view>
  <view class="page-pinned products-pinned">
    <view class="products-store">
      <view class="products-store__copy">
        <text class="products-store__branch">{{branchName}}</text>
        <text class="products-store__meta">预订为主 · 每日 {{businessHours}} 发货或取货</text>
      </view>
      <view class="products-service-note">
        <text>自提价</text>
        <text>北京闪送｜运费实算</text>
      </view>
    </view>
    <view class="products-search">
      <text class="products-search__icon">⌕</text>
      <input
        class="products-search__input"
        value="{{searchText}}"
        placeholder="在芸熙烘焙中搜索"
        placeholder-class="products-search__placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <text wx:if="{{searchText}}" class="products-search__clear" bindtap="clearSearch">×</text>
    </view>
  </view>

  <view class="page-scroll products-scroll-region">
    <view wx:if="{{loadFailed}}" class="yunxi-state">
      <view class="yunxi-state__icon">!</view>
      <text class="yunxi-state__title">商品加载失败</text>
      <text class="yunxi-state__hint">网络开小差了，重试一下吧</text>
      <button class="primary-button yunxi-state__action" bindtap="retryLoad">重新加载</button>
    </view>
    <view wx:elif="{{loading && !loaded}}" class="products-skeleton">
      <view wx:for="{{[1, 2, 3, 4, 5, 6]}}" wx:key="*this" class="products-skeleton__card yunxi-card">
        <view class="products-skeleton__image yunxi-skeleton"></view>
        <view class="products-skeleton__line yunxi-skeleton"></view>
        <view class="products-skeleton__line--short yunxi-skeleton"></view>
      </view>
    </view>
    <!-- 全局搜索结果列表 -->
    <scroll-view
      class="products-global-search"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      hidden="{{!searchText || loadFailed || (loading && !loaded)}}"
    >
      <view class="products-global-search__inner">
        <view class="products-grid">
          <view
            wx:for="{{globalSearchResults}}"
            wx:key="id"
            wx:for-item="product"
            class="product-card yunxi-card hover-scale stagger-fade-in {{product.isUnavailable ? 'is-unavailable' : ''}}"
            data-id="{{product.id}}"
            bindtap="openProduct"
          >
            <view class="product-image">
              <text class="yunxi-badge {{product.badgeClass}} product-badge">{{product.badgeText}}</text>
              <image
                wx:if="{{product.imageUrl && !product.imageFailed}}"
                class="product-cover"
                src="{{product.imageUrl}}"
                mode="aspectFill"
                webp="{{true}}"
                data-id="{{product.id}}"
                binderror="onProductImageError"
              />
              <view wx:else class="yunxi-image-fallback">
                <text class="yunxi-image-fallback__mark">芸</text>
              </view>
            </view>
            <view class="product-info">
              <text class="product-title">{{product.title}}</text>
              <view class="product-meta-row">
                <text class="product-stock {{product.isUnavailable ? 'is-muted' : ''}}">{{product.stockText}}</text>
                <text class="product-hint">{{product.purchaseHint}}</text>
              </view>
              <view class="product-info__bottom">
                <text class="product-price yunxi-price"><text class="yunxi-price__unit">自提价 </text>{{product.priceText}}</text>
                <view
                  class="product-action-btn hover-scale {{product.isUnavailable ? 'is-muted' : ''}}"
                  data-id="{{product.id}}"
                  catchtap="quickAddProduct"
                >{{product.actionText}}</view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{globalSearchResults.length === 0}}" class="products-empty">
          <text class="products-empty__title">暂时没有匹配商品</text>
          <text class="products-empty__hint">请尝试输入其他关键词进行全局检索</text>
        </view>
      </view>
    </scroll-view>

    <!-- 常规分类侧栏与内容布局（保持缓存） -->
    <view wx:if="{{categoriesDegraded && !loadFailed && !(loading && !loaded)}}" class="products-degraded" bindtap="retryLoad">
      <text>分类加载失败，已展示全部商品，点击重试</text>
    </view>
    <view class="products-layout {{isSingleCategoryLayout ? 'is-single-category' : ''}}" hidden="{{!!searchText || loadFailed || (loading && !loaded)}}">
      <scroll-view wx:if="{{!isSingleCategoryLayout}}" class="products-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{categorySections}}"
          wx:key="id"
          wx:for-item="section"
          class="products-sidebar__item {{section.id === activeCategoryId ? 'is-active' : ''}}"
          data-category-id="{{section.id}}"
          bindtap="switchCategory"
        >
          <text class="products-sidebar__title">{{section.title}}</text>
          <text class="products-sidebar__subtitle">{{section.subtitle}}</text>
        </view>
      </scroll-view>

      <view class="products-content-wrapper">
        <scroll-view class="products-content" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="products-content__inner">
            <view class="products-heading">
              <view>
                <text class="products-heading__title">{{activeCategoryTitle}}</text>
                <text class="products-heading__hint">{{activeCategorySubtitle}} · {{activeCategoryCountLabel}} 款</text>
              </view>
              <text class="products-heading__service">自提价</text>
            </view>
            <view class="products-grid products-list">
              <view
                wx:for="{{activeProducts}}"
                wx:key="id"
                wx:for-item="product"
                class="product-card yunxi-card hover-scale stagger-fade-in {{product.isUnavailable ? 'is-unavailable' : ''}}"
                style="animation-delay: {{index * 0.02}}s"
                data-id="{{product.id}}"
                bindtap="openProduct"
              >
                <view class="product-image">
                  <text class="yunxi-badge {{product.badgeClass}} product-badge">{{product.badgeText}}</text>
                  <image
                    wx:if="{{product.imageUrl && !product.imageFailed}}"
                    class="product-cover"
                    src="{{product.imageUrl}}"
                    mode="aspectFill"
                    webp="{{true}}"
                    data-id="{{product.id}}"
                    binderror="onProductImageError"
                  />
                  <view wx:else class="yunxi-image-fallback">
                    <text class="yunxi-image-fallback__mark">芸</text>
                  </view>
                </view>
                <view class="product-info">
                  <text class="product-title">{{product.title}}</text>
                  <view class="product-meta-row">
                    <text class="product-stock {{product.isUnavailable ? 'is-muted' : ''}}">{{product.stockText}}</text>
                    <text class="product-hint">{{product.purchaseHint}}</text>
                  </view>
                  <view class="product-info__bottom">
                    <text class="product-price yunxi-price"><text class="yunxi-price__unit">自提价 </text>{{product.priceText}}</text>
                    <view
                      class="product-action-btn hover-scale {{product.isUnavailable ? 'is-muted' : ''}}"
                      data-id="{{product.id}}"
                      catchtap="quickAddProduct"
                    >{{product.actionText}}</view>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{hasMoreProducts}}" class="products-load-more" bindtap="loadMoreProducts">
              查看更多 {{activeCategoryTitle}}
            </view>

            <view wx:if="{{activeProducts.length === 0 && activeCategoryId !== 'all'}}" class="products-empty">
              <text class="products-empty__title">该分类暂无商品</text>
              <text class="products-empty__hint">再看看其他商品吧</text>
              <view class="products-empty__action" bindtap="switchToAll">查看全部商品</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 已移除悬浮按钮，保持布局简洁 -->
    </view>
  </view>
  <view wx:if="{{cartBarVisible}}" class="products-cart-bar">
    <view class="products-cart-bar__copy" bindtap="goToCart">
      <text class="products-cart-bar__label">预订单</text>
      <text class="products-cart-bar__meta">{{cartSummaryText}}</text>
    </view>
    <text class="products-cart-bar__amount">{{cartTotalText}}</text>
    <button class="primary-button products-cart-bar__submit" bindtap="goCheckout">去结算</button>
  </view>
</view>
