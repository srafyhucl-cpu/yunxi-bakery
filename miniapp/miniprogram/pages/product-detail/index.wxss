/* ==========================================================================
   商品详情页 (Product Detail Page) - 现代自然轻食风格重塑
   ========================================================================== */

.detail-page {
  padding-top: 0;
  padding-bottom: 220rpx;
}

.detail-empty-state {
  padding-top: 160rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 顶部悬浮返回胶囊 */
.detail-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: none;
  background: transparent;
  border-bottom: 0;
}

.detail-back {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  box-sizing: border-box;
  color: var(--yunxi-text-primary);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: none;
  border: 1rpx solid rgba(61, 51, 45, 0.1);
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(35, 50, 42, 0.08);
}

.detail-back--active {
  transform: scale(0.92);
  opacity: 0.85;
}

.detail-back:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.detail-back__icon {
  display: block;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  border: solid currentColor;
  border-width: 0 5rpx 5rpx 0;
  border-radius: 3rpx;
  transform: rotate(135deg);
}

/* 沉浸式大图展示 */
.detail-hero {
  position: relative;
  margin: 0 calc(var(--yunxi-page-gutter) * -1);
  overflow: hidden;
  background: var(--yunxi-surface-alt);
}

.detail-image.immersive-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--yunxi-surface-alt);
  overflow: hidden;
}

.detail-sold-flag {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  z-index: 2;
  padding: 8rpx 20rpx;
  color: #FFFFFF;
  background: rgba(28, 32, 29, 0.65);
  backdrop-filter: none;
  border-radius: var(--yunxi-radius-full);
  font-size: 22rpx;
  font-weight: 700;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 100%;
}

/* 核心信息卡片 */
.detail-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: var(--yunxi-radius-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: var(--yunxi-radius-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 900;
  color: var(--yunxi-text-primary);
}

.detail-status {
  flex: 0 0 auto;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-full);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.detail-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 8rpx;
  border-bottom: 1rpx solid var(--yunxi-border);
  padding-bottom: 24rpx;
}

.detail-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.detail-price-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8A5A36;
  background: rgba(138, 90, 54, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.detail-price {
  color: var(--yunxi-price);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 0;
}

.detail-sold {
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  white-space: nowrap;
}

/* 履约时效服务卡 */
.detail-fulfillment-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #FFFFFF;
}

.fulfillment-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.fulfillment-tag {
  flex-shrink: 0;
  width: 110rpx;
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.fulfillment-val {
  flex: 1;
  color: var(--yunxi-text-primary);
  font-size: 23rpx;
}

.detail-qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}

.detail-qty-label {
  color: var(--yunxi-text-secondary);
  font-size: 28rpx;
  font-weight: 700;
}

.detail-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 8rpx;
}

/* 分区标题 */
.detail-card-title {
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.detail-description {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-description__heading {
  display: block;
  margin-top: 8rpx;
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

/* 搭配推荐横滑列表 */
.related-strip {
  width: 100%;
  white-space: nowrap;
  padding-top: 4rpx;
}

.related-card {
  display: inline-flex;
  flex-direction: column;
  gap: 8rpx;
  width: 200rpx;
  min-height: 280rpx;
  margin-right: 18rpx;
  vertical-align: top;
  overflow: hidden;
  white-space: normal;
}

.related-card:active,
.detail-service:active {
  opacity: 0.72;
}

.related-image {
  width: 200rpx;
  height: 200rpx;
  overflow: hidden;
  border-radius: var(--yunxi-radius-sm);
  background: var(--yunxi-surface-alt);
}

.related-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.related-name {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.related-price {
  color: var(--yunxi-price);
  font-size: 28rpx;
  font-weight: 900;
}

/* 购买须知列表 */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.notice-item {
  position: relative;
  padding-left: 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.notice-item::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--yunxi-brand);
  border-radius: 50%;
}

/* 底部常驻交互栏 */
.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: none;
  border-top: 1rpx solid var(--yunxi-border);
  box-shadow: 0 -8rpx 24rpx rgba(35, 50, 42, 0.04);
}

.detail-service {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 88rpx;
  min-height: 88rpx;
}

.detail-service__icon {
  font-size: 38rpx;
  line-height: 1;
}

.detail-service__label {
  color: var(--yunxi-text-secondary);
  font-size: 20rpx;
  font-weight: 700;
}

.detail-actions button {
  flex: 1;
  width: auto !important;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

/* 详情页按商品信息、履约条件、交易动作分层 */
.detail-content {
  gap: 12rpx;
}

.detail-back {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: none;
  border-radius: 6rpx;
  box-shadow: none;
}

.detail-main,
.detail-section {
  gap: 14rpx;
  padding: 24rpx 20rpx;
  border-radius: var(--yunxi-radius-md);
  box-shadow: none;
}

.detail-title {
  font-size: 36rpx;
}

.detail-status {
  border-radius: 6rpx;
}

.detail-price-label {
  border-radius: 4rpx;
}

.detail-fulfillment-card {
  gap: 0;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.fulfillment-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.fulfillment-row:last-child {
  border-bottom: 0;
}

.detail-actions {
  padding: 12rpx 20rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: #FFFFFF;
  backdrop-filter: none;
  box-shadow: 0 -4rpx 16rpx rgba(61, 51, 45, 0.06);
}

.detail-service {
  width: 64rpx;
  min-height: 72rpx;
}

.detail-service__icon {
  font-size: 28rpx;
}

.detail-actions button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 6rpx;
}
