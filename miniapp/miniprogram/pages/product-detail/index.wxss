.detail-page {
  padding-top: 18rpx;
  padding-bottom: 190rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: none;
  background: transparent;
}

.detail-back {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: var(--yunxi-text-primary);
  background: rgba(237, 247, 232, 0.86);
  border: 1rpx solid rgba(75, 129, 72, 0.12);
  border-radius: 50%;
}

.detail-back__icon {
  margin-top: -4rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 700;
}

.detail-hero {
  padding: 0;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.detail-image.immersive-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  background:
    radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.9), transparent 25%),
    linear-gradient(135deg, #F4F1EB 0%, #ffffff 58%, #E5DFD3 100%);
  border-radius: 0;
  overflow: hidden;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.detail-tag {
  padding: 12rpx 20rpx;
  color: #315d35;
  background: rgba(237, 247, 232, 0.92);
  border-radius: 999rpx;
  font-weight: 700;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 18rpx;
}

.detail-chip {
  max-width: 100%;
  padding: 8rpx 16rpx;
  color: var(--yunxi-accent-deep);
  background: rgba(237, 247, 232, 0.9);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-main {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 26rpx 24rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 900;
}

.detail-status {
  flex: 0 0 auto;
  margin-top: 4rpx;
  padding: 6rpx 14rpx;
  color: #ffffff;
  background: var(--yunxi-accent-deep);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 27rpx;
  line-height: 1.55;
}

.detail-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 4rpx;
}

.detail-price {
  color: var(--yunxi-accent-deep);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.detail-sold {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  white-space: nowrap;
}

.detail-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-radius: 32rpx;
  border: 0;
}

.detail-card-title {
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.detail-description {
  color: var(--yunxi-text-secondary);
  font-size: 27rpx;
  line-height: 1.7;
}

.detail-specs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 4rpx;
}

.detail-spec {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(237, 247, 232, 0.68);
  border-radius: 18rpx;
}

.detail-spec__label {
  flex: 0 0 auto;
  color: var(--yunxi-accent-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.detail-spec__value {
  flex: 1;
  min-width: 0;
  color: var(--yunxi-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  position: relative;
  padding-left: 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.notice-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 9rpx;
  height: 9rpx;
  background: var(--yunxi-accent);
  border-radius: 50%;
}

.detail-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: transparent;
  border-top: 1rpx solid rgba(255, 255, 255, 0.8);
}

.detail-actions button {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 500rpx;
  color: var(--yunxi-text-secondary);
}
