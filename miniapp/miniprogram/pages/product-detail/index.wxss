.detail-page {
  padding-top: 18rpx;
  padding-bottom: 190rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: none;
  background: transparent;
}

.detail-back {
  position: absolute;
  left: var(--yunxi-page-gutter);
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: var(--yunxi-text-primary);
  background: #ffffff;
  border: 1rpx solid var(--yunxi-border);
  border-radius: 50%;
  box-shadow: var(--yunxi-card-shadow);
}

.detail-back__icon {
  margin-top: -4rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 700;
}

.detail-hero {
  position: relative;
  margin: 0 calc(var(--yunxi-page-gutter) * -1);
  overflow: hidden;
  background: #F2E7D2;
}

.detail-image.immersive-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  background:
    radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.9), transparent 25%),
    linear-gradient(135deg, #F2E7D2 0%, #ffffff 58%, #EBD9B8 100%);
  border-radius: 0;
  overflow: hidden;
}

.detail-sold-flag {
  position: absolute;
  left: 28rpx;
  bottom: 56rpx;
  z-index: 2;
  padding: 8rpx 18rpx;
  color: #ffffff;
  background: rgba(28, 22, 18, 0.62);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 100%;
}

/* 缺图与单标签占位改走全局 yunxi-image-fallback */

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 18rpx;
}

/* 标签行改走全局 yunxi-chip */

.detail-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: -32rpx;
  padding: 28rpx 24rpx;
  border-radius: 32rpx 32rpx var(--yunxi-radius-md) var(--yunxi-radius-md);
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 900;
}

.detail-status {
  flex: 0 0 auto;
  margin-top: 4rpx;
  padding: 6rpx 14rpx;
  color: #ffffff;
  background: var(--yunxi-accent-deep);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-subtitle {
  color: var(--yunxi-text-secondary);
  font-size: 27rpx;
  line-height: 1.55;
}

.detail-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 4rpx;
}

.detail-price {
  color: var(--yunxi-deal);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.15;
}

.detail-sold {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  white-space: nowrap;
}

.detail-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-radius: 32rpx;
  border: 0;
}

.detail-card-title {
  color: var(--yunxi-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.detail-description {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: var(--yunxi-text-secondary);
  font-size: 27rpx;
  line-height: 1.7;
}

.detail-description__heading {
  display: block;
  margin-top: 8rpx;
  color: var(--yunxi-text-primary);
  font-size: 27rpx;
  font-weight: 800;
}

.detail-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 4rpx;
}

/* 规格展示改走全局 yunxi-chip，不做可选项 */

.detail-qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

.detail-qty-label {
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
}

.related-strip {
  width: 100%;
  white-space: nowrap;
}

.related-card {
  display: inline-flex;
  flex-direction: column;
  gap: 8rpx;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.related-image {
  width: 200rpx;
  height: 200rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #F2E7D2;
}

.related-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.related-name {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.related-price {
  color: var(--yunxi-price);
  font-size: 28rpx;
  font-weight: 900;
}

.detail-service {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 96rpx;
  min-height: 88rpx;
}

.detail-service__icon {
  font-size: 40rpx;
  line-height: 1;
}

.detail-service__label {
  color: var(--yunxi-text-secondary);
  font-size: 20rpx;
  font-weight: 700;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  position: relative;
  padding-left: 24rpx;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.notice-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 9rpx;
  height: 9rpx;
  background: var(--yunxi-accent);
  border-radius: 50%;
}

.detail-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: #ffffff;
  border-top: 1rpx solid var(--yunxi-border);
}

.detail-actions button {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 500rpx;
  color: var(--yunxi-text-secondary);
}
