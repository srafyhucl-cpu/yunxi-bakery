<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title detail-nav glass-panel{{navSolid ? ' detail-nav--solid' : ''}}">
    <button class="page-nav-back" bindtap="goBack" aria-label="返回">
      <text class="page-nav-back__icon"></text>
    </button>
    <view class="page-fixed-safe__title">商品详情</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onScroll">
    <view class="page detail-page">
      <view wx:if="{{product}}" class="detail-content fade-in">
        <view class="detail-hero">
          <view class="detail-image immersive-image">
            <image wx:if="{{product.imageUrl && !product.imageFailed}}" class="detail-cover" src="{{product.imageUrl}}" mode="aspectFill" binderror="onDetailImageError" />
            <view wx:else class="yunxi-image-fallback">
              <text class="yunxi-image-fallback__mark">芸</text>
            </view>
          </view>
        </view>

        <view class="detail-main detail-section">
          <view wx:if="{{product.tagChips.length > 0}}" class="detail-tags">
            <text wx:for="{{product.tagChips}}" wx:key="*this" wx:for-item="tag" class="yunxi-chip">{{tag}}</text>
          </view>
          <view class="detail-title-row">
            <text class="detail-title">{{product.title}}</text>
            <text wx:if="{{!canPurchase}}" class="detail-status">{{unavailableText}}</text>
          </view>
          <text wx:if="{{product.displaySubtitle}}" class="detail-subtitle">{{product.displaySubtitle}}</text>
          <!-- 非卖品没有真实售价：不展示同步占位价与库存文案 -->
          <view wx:if="{{!isDisplayOnly}}" class="detail-meta">
            <view class="detail-price-wrap">
              <text class="detail-price-label">门店自提价</text>
              <text class="detail-price">{{product.priceText}}</text>
            </view>
            <text class="detail-sold">{{product.soldText}}</text>
          </view>
          <view wx:if="{{canPurchase}}" class="detail-qty-row">
            <text class="detail-qty-label">数量</text>
            <view class="yunxi-stepper">
              <view class="yunxi-stepper__btn yunxi-stepper__btn--minus" bindtap="decreaseQty">-</view>
              <text class="yunxi-stepper__val">{{purchaseQty}}</text>
              <view class="yunxi-stepper__btn yunxi-stepper__btn--plus" bindtap="increaseQty">+</view>
            </view>
          </view>
          <view wx:if="{{product.specChips.length > 0}}" class="detail-specs">
            <text wx:for="{{product.specChips}}" wx:key="*this" wx:for-item="spec" class="yunxi-chip">{{spec}}</text>
          </view>
        </view>

        <!-- 履约与预订服务卡 -->
        <view wx:if="{{canPurchase}}" class="detail-section detail-fulfillment-card">
          <view class="fulfillment-row">
            <text class="fulfillment-tag">履约方式</text>
            <text class="fulfillment-val">支持 门店自提 · 北京闪送</text>
          </view>
          <view class="fulfillment-row">
            <text class="fulfillment-tag">下单说明</text>
            <text class="fulfillment-val">{{product.displayFulfillment}}</text>
          </view>
          <view class="fulfillment-row">
            <text class="fulfillment-tag">配送时段</text>
            <text class="fulfillment-val">每日 09:00 - 19:30 发货；当天订单 17:00 截单</text>
          </view>
          <view class="fulfillment-row">
            <text class="fulfillment-tag">运费说明</text>
            <text class="fulfillment-val">闪送费按实际收货距离下单前确认，并与商品金额一并支付</text>
          </view>
        </view>

        <view wx:elif="{{isDisplayOnly}}" class="detail-section detail-display-only-card">
          <text class="detail-display-only-card__title">仅供展示</text>
          <text class="detail-display-only-card__desc">此商品用于说明门店使用的原料或展示产品，不提供直接购买。</text>
        </view>

        <view class="detail-section">
          <text class="detail-card-title">图文详情</text>
          <view class="detail-description">
            <block wx:for="{{product.descriptionBlocks}}" wx:key="index" wx:for-item="block">
              <text wx:if="{{block.isHeading}}" class="detail-description__heading">{{block.text}}</text>
              <text wx:else class="notice-item">{{block.text}}</text>
            </block>
          </view>
        </view>

        <view class="detail-section">
          <text class="detail-card-title">购买须知</text>
          <view class="notice-list">
            <text wx:for="{{product.notices}}" wx:key="*this" wx:for-item="notice" class="notice-item">{{notice}}</text>
          </view>
        </view>

        <view wx:if="{{relatedProducts.length > 0}}" class="detail-section">
          <text class="detail-card-title">搭配推荐</text>
          <scroll-view class="related-strip" scroll-x enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{relatedProducts}}"
              wx:key="id"
              wx:for-item="related"
              class="related-card"
              data-id="{{related.id}}"
              bindtap="openRelated"
            >
              <view class="related-image">
                <image wx:if="{{related.imageUrl && !related.imageFailed}}" class="related-cover" src="{{related.imageUrl}}" mode="aspectFill" data-id="{{related.id}}" binderror="onRelatedImageError" />
                <view wx:else class="yunxi-image-fallback">
                  <text class="yunxi-image-fallback__mark">芸</text>
                </view>
              </view>
              <text class="related-name">{{related.title}}</text>
              <text class="related-price">{{related.priceText}}</text>
            </view>
          </scroll-view>
        </view>
      </view>
      <view wx:else class="yunxi-state detail-empty-state">
        <view class="yunxi-state__icon yunxi-state__icon--cake" aria-hidden="true"></view>
        <text class="yunxi-state__title">{{unavailableText}}</text>
        <text wx:if="{{loadFailed}}" class="yunxi-state__hint">网络开小差了，重试一下吧</text>
        <text wx:elif="{{!lastProductId}}" class="yunxi-state__hint">从商品列表进入，或返回首页继续选购</text>
        <text wx:else class="yunxi-state__hint">这个商品暂时无法购买，先看看其他畅销商品吧</text>
        <button wx:if="{{loadFailed}}" class="primary-button yunxi-state__action" bindtap="retryLoad">重新加载</button>
        <button wx:else class="ghost-button yunxi-state__action" bindtap="goBack">返回选购</button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{product}}" class="detail-actions">
    <block wx:if="{{canPurchase}}">
    <view class="detail-service" bindtap="goChat" aria-label="联系客服">
      <view class="detail-service__icon detail-service__icon--chat" aria-hidden="true"></view>
      <text class="detail-service__label">客服</text>
    </view>
    <view class="detail-service" bindtap="goCart" aria-label="查看购物车">
      <view class="detail-service__icon detail-service__icon--cart" aria-hidden="true"></view>
      <text class="detail-service__label">购物车</text>
    </view>
    <button
      class="ghost-button"
      bindtap="addToCart"
      loading="{{addingToCart}}"
      disabled="{{loading || !canPurchase || addingToCart || buyingNow}}"
    >
      {{canPurchase ? '加入购物车' : unavailableText}}
    </button>
    <button
      class="primary-button hover-scale"
      bindtap="buyNow"
      loading="{{buyingNow}}"
      disabled="{{loading || !canPurchase || addingToCart || buyingNow}}"
    >
      {{canPurchase ? '立即购买' : unavailableText}}
    </button>
    </block>
    <block wx:else>
      <button class="ghost-button" bindtap="goBack">返回选购</button>
      <button class="primary-button hover-scale" bindtap="goChat">咨询客服</button>
    </block>
  </view>
</view>
