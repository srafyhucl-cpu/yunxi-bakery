<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title detail-nav glass-panel">
    <button class="detail-back" bindtap="goBack" aria-label="返回">
      <text class="detail-back__icon">‹</text>
    </button>
    <view class="page-fixed-safe__title">商品详情</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page detail-page">
      <view wx:if="{{product}}" class="detail-content fade-in">
        <view class="detail-hero">
          <view class="detail-image immersive-image">
            <image wx:if="{{product.imageUrl && !product.imageFailed}}" class="detail-cover" src="{{product.imageUrl}}" mode="aspectFill" binderror="onDetailImageError" />
            <view wx:else class="yunxi-image-fallback">
              <text class="yunxi-image-fallback__mark">芸</text>
            </view>
          </view>
          <text wx:if="{{product.soldText}}" class="detail-sold-flag">{{product.soldText}}</text>
        </view>

        <view class="detail-main yunxi-card">
          <view wx:if="{{product.tagChips.length > 0}}" class="detail-tags">
            <text wx:for="{{product.tagChips}}" wx:key="*this" wx:for-item="tag" class="yunxi-chip">{{tag}}</text>
          </view>
          <view class="detail-title-row">
            <text class="detail-title">{{product.title}}</text>
            <text class="detail-status">{{product.isActive ? "在售" : "暂不可售"}}</text>
          </view>
          <text wx:if="{{product.displaySubtitle}}" class="detail-subtitle">{{product.displaySubtitle}}</text>
          <view class="detail-meta">
            <text class="detail-price">{{product.priceText}}</text>
            <text class="detail-sold">{{product.soldText}}</text>
          </view>
          <view wx:if="{{canPurchase}}" class="detail-qty-row">
            <text class="detail-qty-label">数量</text>
            <view class="yunxi-stepper">
              <view class="yunxi-stepper__btn yunxi-stepper__btn--minus" bindtap="decreaseQty">-</view>
              <text class="yunxi-stepper__val">{{purchaseQty}}</text>
              <view class="yunxi-stepper__btn yunxi-stepper__btn--plus" bindtap="increaseQty">+</view>
            </view>
          </view>
          <view wx:if="{{product.specChips.length > 0}}" class="detail-specs">
            <text wx:for="{{product.specChips}}" wx:key="*this" wx:for-item="spec" class="yunxi-chip">{{spec}}</text>
          </view>
        </view>

        <view class="detail-card yunxi-card">
          <view class="yunxi-section-head">
            <text class="yunxi-section-head__title">图文详情</text>
          </view>
          <view class="detail-description">
            <block wx:for="{{product.descriptionBlocks}}" wx:key="index" wx:for-item="block">
              <text wx:if="{{block.isHeading}}" class="detail-description__heading">{{block.text}}</text>
              <text wx:else class="notice-item">{{block.text}}</text>
            </block>
          </view>
        </view>

        <view class="detail-card yunxi-card">
          <text class="detail-card-title">购买须知</text>
          <view class="notice-list">
            <text wx:for="{{product.notices}}" wx:key="*this" wx:for-item="notice" class="notice-item">{{notice}}</text>
          </view>
        </view>

        <view wx:if="{{relatedProducts.length > 0}}" class="detail-card yunxi-card">
          <view class="yunxi-section-head">
            <text class="yunxi-section-head__title">搭配推荐</text>
          </view>
          <scroll-view class="related-strip" scroll-x enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{relatedProducts}}"
              wx:key="id"
              wx:for-item="related"
              class="related-card"
              data-id="{{related.id}}"
              bindtap="openRelated"
            >
              <view class="related-image">
                <image wx:if="{{related.imageUrl && !related.imageFailed}}" class="related-cover" src="{{related.imageUrl}}" mode="aspectFill" data-id="{{related.id}}" binderror="onRelatedImageError" />
                <view wx:else class="yunxi-image-fallback">
                  <text class="yunxi-image-fallback__mark">芸</text>
                </view>
              </view>
              <text class="related-name">{{related.title}}</text>
              <text class="related-price">{{related.priceText}}</text>
            </view>
          </scroll-view>
        </view>
      </view>
      <view wx:else class="yunxi-state">
        <view class="yunxi-state__icon">🍰</view>
        <text class="yunxi-state__title">{{unavailableText}}</text>
        <text wx:if="{{loadFailed}}" class="yunxi-state__hint">网络开小差了，重试一下吧</text>
        <button wx:if="{{loadFailed}}" class="primary-button yunxi-state__action" bindtap="retryLoad">重新加载</button>
      </view>
    </view>
  </scroll-view>

  <view class="detail-actions">
    <view class="detail-service" bindtap="goChat">
      <text class="detail-service__icon">💬</text>
      <text class="detail-service__label">客服</text>
    </view>
    <button
      class="ghost-button"
      bindtap="addToCart"
      loading="{{addingToCart}}"
      disabled="{{loading || !canPurchase || addingToCart || buyingNow}}"
    >
      {{canPurchase ? '加入购物车' : unavailableText}}
    </button>
    <button
      class="primary-button hover-scale"
      bindtap="buyNow"
      loading="{{buyingNow}}"
      disabled="{{loading || !canPurchase || addingToCart || buyingNow}}"
    >
      {{canPurchase ? '立即购买' : unavailableText}}
    </button>
  </view>
</view>
