/* ==========================================================================
   优惠券 —— 印刷票券（柔白纸面 / 1rpx 虚线齿孔 / 竖排状态）
   状态标签条为下划线式；券票是唯一保留卡片外观的内容单元：
   2rpx 圆角、1rpx 细线、无阴影、无绿色大色块。
   ========================================================================== */

.coupons-page {
  padding: 0 0 var(--yunxi-page-bottom-space);
  background: var(--yunxi-page-bg);
}

/* 状态标签条：纸白平面条，选中项用墨色文字 + 2rpx 底线标识 */
.coupon-tabs {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 0;
  width: 100%;
  margin: 0;
  padding: 0;
  background: var(--yunxi-surface);
  border-bottom: 1rpx solid var(--yunxi-border);
}

.coupon-tab {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 8rpx 18rpx;
  color: var(--yunxi-text-secondary);
  background: transparent;
  border: 0;
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-tab:active {
  opacity: 0.6;
}

.coupon-tab.active {
  color: var(--yunxi-text-primary);
  font-weight: 500;
}

/* 选中下划线：2rpx 墨色底线 */
.coupon-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 36rpx;
  height: 2rpx;
  margin-left: -18rpx;
  background: var(--yunxi-text-primary);
  border-radius: 0;
}

/* 数量：小号上标文本 */
.coupon-tab-count {
  position: relative;
  top: -8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--yunxi-text-muted);
  font-variant-numeric: tabular-nums;
}

.coupon-tab.active .coupon-tab-count {
  color: var(--yunxi-gold);
}

/* 券票列表：纸底上摊开的一叠票面 */
.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx var(--yunxi-page-gutter) 40rpx;
  background: var(--yunxi-page-bg);
  border-bottom: 1rpx solid var(--yunxi-border);
}

/* 券票：柔白纸面 + 1rpx 细线 + 2rpx 圆角，无阴影 */
.coupon-card {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  background: var(--yunxi-surface);
  border: 1rpx solid var(--yunxi-border);
  border-radius: 2rpx;
  box-shadow: none;
}

/* 券面金额：去掉绿色色块，只留深林绿数字 */
.coupon-value {
  width: auto;
  min-width: 184rpx;
  max-width: 240rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 16rpx;
  background: transparent;
  color: var(--yunxi-brand);
  font-weight: 500;
  white-space: nowrap;
}

.coupon-value-num {
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.01em;
  font-variant-numeric: tabular-nums;
}

.coupon-value-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
  transform: translateY(12rpx);
}

/* 券面信息：与金额之间是 1rpx 虚线齿孔 */
.coupon-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx 24rpx;
  border-left: 1rpx dashed var(--yunxi-border-medium);
}

.coupon-title {
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-primary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-threshold {
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-secondary);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-valid {
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-order {
  min-width: 0;
  overflow: hidden;
  color: var(--yunxi-text-muted);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 券状态：右侧竖排窄字距标记，不做色块 */
.coupon-note {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background: transparent;
  border-left: 0;
  color: var(--yunxi-text-muted);
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 0.16em;
  writing-mode: vertical-rl;
}

/* 加载中：纸白平面分区，不做卡片 */
.empty-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  background: var(--yunxi-surface);
  border: 0;
  border-bottom: 1rpx solid var(--yunxi-border);
  border-radius: 0;
}

.empty-title {
  color: var(--yunxi-text-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.empty-subtitle {
  margin-top: 12rpx;
  color: var(--yunxi-text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}
