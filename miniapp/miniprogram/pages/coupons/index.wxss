/* ==========================================================================
   优惠券页 (Coupons Page) - 现代自然轻食风格重塑
   ========================================================================== */

.coupons-page {
  padding: 24rpx;
}

.coupon-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.coupon-tab {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--yunxi-text-secondary);
  background: var(--yunxi-surface-alt);
  border-radius: var(--yunxi-radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.25s ease;
}

.coupon-tab:active {
  opacity: 0.78;
}

.coupon-tab.active {
  color: #FFFFFF;
  background: var(--yunxi-brand);
  box-shadow: 0 4rpx 12rpx rgba(61, 51, 45, 0.16);
}

.coupon-tab-count {
  font-size: 22rpx;
  opacity: 0.9;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-md);
  overflow: hidden;
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.coupon-value {
  width: 188rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 28rpx 0;
  background: var(--yunxi-gold-light);
  color: #1A2E26;
  font-weight: 900;
}

.coupon-value-num {
  font-size: 48rpx;
  font-weight: 900;
}

.coupon-value-unit {
  font-size: 24rpx;
  margin-left: 2rpx;
}

.coupon-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

.coupon-threshold,
.coupon-valid,
.coupon-order {
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.coupon-note {
  writing-mode: vertical-rl;
  padding: 20rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--yunxi-deal);
  background: var(--yunxi-surface-alt);
  display: flex;
  align-items: center;
  letter-spacing: 0.1em;
}

.empty-panel {
  padding: 80rpx 32rpx;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

.empty-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--yunxi-text-muted);
}

/* 需要带页面作用域压过 app.wxss 的 button:not([size="mini"]) 重置，否则背景透明而文字为白色。 */
.coupons-page button.primary-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(61, 51, 45, 0.16);
}

.coupons-page button.primary-btn:active {
  transform: scale(0.97);
  opacity: 0.94;
}
