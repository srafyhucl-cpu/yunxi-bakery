/* ==========================================================================
   会员中心 (Member Profile Page) - 温暖清晰的会员服务页
   ========================================================================== */

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 28rpx calc(var(--yunxi-page-bottom-space) + 40rpx);
  background: var(--yunxi-page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户头部 */
.profile-header {
  padding: 12rpx 4rpx;
}

.profile-user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--yunxi-card-shadow);
  border: 1rpx solid var(--yunxi-border);
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--yunxi-brand-soft);
  color: var(--yunxi-brand);
  font-size: 40rpx;
  font-weight: 800;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--yunxi-text-primary);
}

.profile-level-badge {
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--yunxi-gold);
  border-radius: var(--yunxi-radius-full);
  box-shadow: 0 4rpx 10rpx rgba(194, 155, 99, 0.25);
}

.profile-subtext {
  font-size: 24rpx;
  color: var(--yunxi-text-muted);
}

/* 资产面板 (余额 / 积分 / 优惠券) */
.metrics-panel {
  padding: 24rpx 0;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.metrics-header {
  padding: 0 32rpx 16rpx;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.metrics-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
  letter-spacing: 0.04em;
}

.metrics-grid {
  display: flex;
  padding: 24rpx 12rpx 12rpx;
  text-align: center;
}

.metric-col {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0;
  min-height: 100rpx;
}

.metric-col:active,
.panel-card__all:active,
.service-cell:active {
  opacity: 0.72;
}

.metric-val {
  display: block;
  color: var(--yunxi-text-primary);
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.metric-unit {
  font-size: 22rpx;
  font-weight: 700;
  margin-left: 2rpx;
}

.metric-lbl {
  color: var(--yunxi-text-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.metric-entry {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--yunxi-brand);
}

/* 尊享黑绿金会员卡 */
.member-card-wrapper {
  width: 100%;
}

.luxury-member-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 268rpx;
  padding: 36rpx;
  border-radius: var(--yunxi-radius-lg);
  color: #FFFFFF;
  background: #2B231F;
  border: 1rpx solid rgba(194, 155, 99, 0.35);
  box-shadow: 0 20rpx 48rpx rgba(14, 31, 24, 0.28);
  position: relative;
  overflow: hidden;
}

.card-logo-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-brand {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--yunxi-gold-light);
}

.card-type {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.45);
}

.card-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 0;
}

.card-holder-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-holder-level {
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 0.02em;
}

.card-holder-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.profile-page button.card-action-btn {
  width: 128rpx !important;
  min-width: 128rpx !important;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 1.2;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #1A2E26;
  background: var(--yunxi-gold-light);
  border-radius: var(--yunxi-radius-sm);
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
}

.profile-page button.card-action-btn[disabled] {
  background: rgba(255, 255, 255, 0.2) !important;
  color: rgba(255, 255, 255, 0.5) !important;
}

.card-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.card-number {
  letter-spacing: 0.1em;
}

/* 订单与服务面板 */
.panel-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  padding: 30rpx 28rpx;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.panel-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-card__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

.panel-card__all {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  min-height: 48rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--yunxi-brand);
}

.order-navigation-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.order-nav-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.order-nav-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--yunxi-radius-md);
  background: var(--yunxi-surface-alt);
  border: 1rpx solid var(--yunxi-border);
}

.order-nav-icon {
  color: var(--yunxi-brand);
  font-size: 30rpx;
  font-weight: 800;
}

.order-nav-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--yunxi-text-secondary);
}

/* 服务列表单元格 */
.service-list {
  display: flex;
  flex-direction: column;
}

.service-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--yunxi-border);
  overflow: hidden;
}

.service-cell:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.service-cell__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-cell__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  color: var(--yunxi-brand);
  background: var(--yunxi-brand-soft);
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

.service-cell__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--yunxi-text-primary);
}

.service-cell__right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.service-cell__subtitle {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--yunxi-text-muted);
}

.service-cell__arrow {
  font-size: 28rpx;
  color: var(--yunxi-text-subtle);
  line-height: 1;
}
