.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 28rpx calc(var(--yunxi-page-bottom-space) + 40rpx);
  background: #faf8f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 会员资料头部 */
.profile-header {
  padding: 16rpx 8rpx;
}

.profile-user-info {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.profile-avatar-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 99rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(74, 122, 65, 0.06);
  border: 1rpx solid rgba(74, 122, 65, 0.04);
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 114rpx;
  height: 114rpx;
  border-radius: 99rpx;
  background: linear-gradient(135deg, #eaf7e3, #cce8bf);
  color: #4a7a41;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #243a28;
}

.profile-level-badge {
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #8c7647;
  background: linear-gradient(135deg, #fbf2db, #f3ddab);
  border-radius: 99rpx;
  border: 1rpx solid rgba(140, 118, 71, 0.15);
}

.profile-subtext {
  font-size: 24rpx;
  color: #728073;
}

/* 资产指标面板 */
.metrics-panel {
  padding: 24rpx 0rpx;
  background: #ffffff;
}

.metrics-header {
  padding: 0 32rpx 16rpx;
  border-bottom: 1rpx solid rgba(74, 122, 65, 0.04);
}

.metrics-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #5b695c;
  letter-spacing: 0.05em;
}

.metrics-grid {
  display: flex;
  padding: 24rpx 12rpx 12rpx;
  text-align: center;
}

.metric-col {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.metric-val {
  display: block;
  color: #243a28;
  font-size: 34rpx;
  font-weight: 800;
}

.metric-unit {
  font-size: 20rpx;
  font-weight: 700;
  margin-left: 2rpx;
}

.metric-lbl {
  color: #9cb09e;
  font-size: 22rpx;
  font-weight: 600;
}

/* 会员卡 */
.member-card-wrapper {
  width: 100%;
}

.luxury-member-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 256rpx;
  padding: 36rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1f3521 0%, #0c1a0e 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 48rpx rgba(12, 26, 14, 0.25);
  position: relative;
  overflow: hidden;
}

/* 金色渐变叠加背景 */
.luxury-member-card::before {
  content: "";
  position: absolute;
  top: -10%;
  right: -10%;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(243, 221, 171, 0.12), transparent 70%);
  pointer-events: none;
}

.card-logo-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-brand {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: #f3ddab;
}

.card-type {
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.4);
}

.card-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 0;
}

.card-holder-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-holder-level {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.02em;
}

.card-holder-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.card-action-btn {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: #1a301c;
  background: linear-gradient(135deg, #fbf2db, #f3ddab);
  border-radius: 99rpx;
  font-size: 22rpx;
  font-weight: 800;
  margin: 0;
  box-shadow: 0 8rpx 16rpx rgba(243, 221, 171, 0.2);
}

.card-action-btn[disabled] {
  background: rgba(255, 255, 255, 0.2) !important;
  color: rgba(255, 255, 255, 0.5) !important;
}

.card-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.45);
}

.card-number {
  letter-spacing: 0.08em;
}

/* 面板卡片 */
.panel-card {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  padding: 28rpx;
}

.panel-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-card__title {
  font-size: 30rpx;
  font-weight: 800;
  color: #243a28;
}

.panel-card__all {
  font-size: 24rpx;
  font-weight: 700;
  color: #9cb09e;
}

/* 订单导航网格 */
.order-navigation-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.order-nav-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0rpx;
}

.order-nav-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: #f8f6f2;
  border: 1rpx solid rgba(74, 122, 65, 0.05);
}

.order-nav-emoji {
  font-size: 36rpx;
}

.order-nav-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #556056;
}

/* 服务列表单元格 */
.service-list {
  display: flex;
  flex-direction: column;
}

.service-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(74, 122, 65, 0.04);
}

.service-cell:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.service-cell__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-cell__emoji {
  font-size: 30rpx;
}

.service-cell__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #243a28;
}

.service-cell__right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.service-cell__subtitle {
  font-size: 23rpx;
  font-weight: 600;
  color: #9cb09e;
}

.service-cell__arrow {
  font-size: 28rpx;
  color: #cce0c9;
  line-height: 1;
}
.metric-entry {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6c9a63;
}
