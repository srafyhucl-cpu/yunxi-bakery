<view class="page-shell" style="{{layoutStyle}}">
  <view class="page-fixed-safe has-custom-title">
    <button class="page-nav-back" bindtap="goBack" aria-label="返回">
      <text class="page-nav-back__icon"></text>
    </button>
    <view class="page-fixed-safe__title">积分明细</view>
  </view>
  <view class="page-pinned page-pinned--empty"></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page points-page">
      <view wx:if="{{!loggedIn}}" class="yunxi-state yunxi-state--page">
        <view class="yunxi-state__icon yunxi-state__icon--star" aria-hidden="true"></view>
        <text class="yunxi-state__title">登录后查看积分</text>
        <text class="yunxi-state__hint">登录后可查看积分余额与获取、抵扣记录</text>
        <button class="primary-button yunxi-state__action" bindtap="goLogin">去登录</button>
      </view>
      <block wx:else>
        <view class="balance-panel glass-panel fade-in">
          <text class="balance-label">当前积分</text>
          <text class="balance-value">{{pointsBalance != null ? pointsBalance : '--'}}</text>
        </view>
        <view wx:if="{{loading}}" class="empty-panel glass-panel">
          <text class="empty-title">加载中...</text>
        </view>
        <view wx:elif="{{loadFailed}}" class="yunxi-state yunxi-state--page">
          <view class="yunxi-state__icon yunxi-state__icon--wifi-off" aria-hidden="true"></view>
          <text class="yunxi-state__title">积分明细加载失败</text>
          <text class="yunxi-state__hint">网络开小差了，重试一下吧</text>
          <button class="primary-button yunxi-state__action" bindtap="retryLoad">重新加载</button>
        </view>
        <view wx:elif="{{rows.length === 0}}" class="yunxi-state yunxi-state--page">
          <view class="yunxi-state__icon yunxi-state__icon--star" aria-hidden="true"></view>
          <text class="yunxi-state__title">暂无积分记录</text>
          <text class="yunxi-state__hint">下单消费可获得积分奖励</text>
          <button class="primary-button yunxi-state__action" bindtap="goProducts">去选购</button>
        </view>
        <view wx:else class="ledger-list">
          <view wx:for="{{rows}}" wx:key="index" class="ledger-row">
            <view class="ledger-main">
              <text class="ledger-label">{{item.label}}</text>
              <text class="ledger-time">{{item.displayTime}}</text>
            </view>
            <view class="ledger-amount {{item.amount >= 0 ? 'positive' : 'negative'}}">
              {{item.amount >= 0 ? '+' : ''}}{{item.amount}}
            </view>
            <view class="ledger-total">余额 {{item.total}}</view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
