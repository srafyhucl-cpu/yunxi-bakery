/* ==========================================================================
   积分中心页 (Points Page) - 现代自然轻食风格重塑
   ========================================================================== */

.points-page {
  padding: 24rpx;
}

.balance-panel {
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
}

.balance-label {
  font-size: 26rpx;
  color: var(--yunxi-text-muted);
}

.balance-value {
  margin-top: 12rpx;
  font-size: 68rpx;
  font-weight: 900;
  color: var(--yunxi-text-primary);
  letter-spacing: 0;
}

.ledger-list {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: var(--yunxi-radius-lg);
  border: 1rpx solid var(--yunxi-border);
  box-shadow: var(--yunxi-card-shadow);
  padding: 12rpx 28rpx;
}

.ledger-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--yunxi-border);
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ledger-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--yunxi-text-primary);
}

.ledger-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.ledger-amount {
  font-size: 32rpx;
  font-weight: 900;
}

.ledger-amount.positive {
  color: var(--yunxi-brand);
}

.ledger-amount.negative {
  color: var(--yunxi-deal);
}

.ledger-total {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--yunxi-text-muted);
}

.empty-panel {
  padding: 80rpx 32rpx;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--yunxi-text-primary);
}

.empty-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--yunxi-text-muted);
}

/* 需要带页面作用域压过 app.wxss 的 button:not([size="mini"]) 重置，否则背景透明而文字为白色。 */
.points-page button.primary-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  color: #FFFFFF;
  background: var(--yunxi-brand);
  border-radius: var(--yunxi-radius-sm);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(61, 51, 45, 0.16);
}
